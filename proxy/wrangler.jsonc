// Production link without the account's workers.dev name: a Cloudflare Pages project (well-ads.pages.dev)
// whose only job is to hand every request to the production Worker over a service binding.
// The Worker keeps workers_dev off, so this is its only public address.
{
  "$schema": "../node_modules/wrangler/config-schema.json",
  "name": "well-ads",
  "pages_build_output_dir": "./public",
  "compatibility_date": "2026-10-01",
  "services": [{ "binding": "APP", "service": "well-ads" }]
}
