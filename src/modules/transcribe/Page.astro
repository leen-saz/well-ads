---
import { ClientRouter } from 'astro:transitions';
// التفريغ: ارفع صوت أو فيديو، ويطلع النص باللهجة مع التوقيت وملخص. السكربت في public/modules/transcribe/client.js
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>التفريغ · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>
.tr-grid{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:1000px){.tr-grid{grid-template-columns:1fr}}
.tr-grid h2{margin:0 0 6px}
.tr-bar{height:8px;border-radius:999px;background:var(--tint-2);overflow:hidden;margin-top:10px}
.tr-bar i{display:block;height:100%;background:var(--accent);width:0;transition:width .3s ease-out}
.tr-jobs{display:grid;gap:12px}
.tr-job{padding:14px 16px;display:grid;gap:8px}
.tr-top{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.tr-top h3{margin:0;font-size:16px}
.tr-chip{font-size:12px;padding:2px 10px;border-radius:999px;background:var(--tint)}
.tr-chip.ok{background:color-mix(in srgb,var(--accent) 16%,transparent)}
.tr-chip.bad{background:color-mix(in srgb,var(--pulse) 14%,transparent)}
.tr-sum{white-space:pre-wrap;margin:0;font-size:15px;line-height:1.8}
.tr-h{font-size:13px;color:var(--muted);margin:6px 0 0}
.tr-list{margin:2px 0 0;padding-inline-start:18px;font-size:15px;line-height:1.8}
.tr-warn{font-size:13px;padding:8px 12px;border-radius:12px;background:color-mix(in srgb,var(--pulse) 12%,transparent)}
.tr-text{white-space:pre-wrap;font-size:14px;line-height:1.9;margin:8px 0 0;max-height:420px;overflow:auto;direction:auto}
.tr-act{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.tr-empty{padding:28px 16px;text-align:center}
</style>
</head>
<body data-page="transcribe" data-module>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <p class="muted" style="margin:0 0 14px">ارفع ملف صوت أو فيديو، ويطلع لك النص باللهجة مع التوقيت وملخص. الملف ينحذف بعد التفريغ ويبقى النص بس.</p>
      <div class="so-note" id="notready" hidden role="status"></div>
      <div class="tr-grid">
        <section class="card pad">
          <h2>ملف جديد</h2>
          <form id="uf" novalidate>
            <label for="file">الملف</label><input type="file" id="file" accept="audio/*,video/*,.mp3,.m4a,.wav,.mp4,.mov">
            <label for="title">العنوان <span class="muted">(اختياري)</span></label><input type="text" id="title" maxlength="120" placeholder="مثلاً: اجتماع التسويق الأسبوعي">
            <label for="purpose">نوع الملف</label><select id="purpose"></select>
            <p class="muted" id="limits" style="font-size:13px;margin:8px 0 0"></p>
            <div class="bar" style="margin-top:14px"><button class="btn primary" type="submit" id="go">ابدأ التفريغ</button></div>
            <div class="tr-bar" id="prog" hidden><i id="progI"></i></div>
            <div class="msg" id="msg" role="status"></div>
          </form>
        </section>
        <section>
          <div id="jobs" class="tr-jobs" aria-live="polite"></div>
        </section>
      </div>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
