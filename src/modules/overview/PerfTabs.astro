---
// تابات الأداء فوق المحتوى: نظرة عامة، والكرييتف بالتفصيل. نفس شكل تابات الإعدادات.
interface Props { current: 'overview' | 'creative' }
const { current } = Astro.props;
const tabs = [['/overview/', 'نظرة عامة', 'overview'], ['/overview/creative/', 'الكرييتف بالتفصيل', 'creative']] as const;
---
<nav class="tabs settings-tabs" aria-label="الأداء">
  {tabs.map(([href, text, key]) => <a href={href} aria-current={key === current ? 'page' : undefined}>{text}</a>)}
</nav>
