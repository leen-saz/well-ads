---
import { ClientRouter } from 'astro:transitions';
import Creative from './Creative';
import PerfTabs from './PerfTabs.astro';
import { CreativeSkeleton } from './Skeletons';
import '../../styles/ui.css';
// المواد الإعلانية بالتفصيل: تاب تحت الأداء، بنفس بيانات ملخص الأداء وصلاحيتها. القائمة والعنوان من public/modules/overview/client.js.
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>المواد الإعلانية · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
</head>
<body data-page="overview" data-module>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <PerfTabs current="creative" />
      <Creative client:only="react"><CreativeSkeleton slot="fallback" /></Creative>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
