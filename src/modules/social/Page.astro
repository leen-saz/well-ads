---
import { ClientRouter } from 'astro:transitions';
// السوشال: تقويم المنشورات لكل شركة. النشر يشغّله Cron في الـ Worker (src/modules/social/cron.ts).
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>السوشال · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>
.so-grid{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:1000px){.so-grid{grid-template-columns:1fr}}
.so-cnt{font-size:12px;margin:4px 0 0}.so-cnt.over{color:#C0392B}
.so-day{margin:18px 0 8px;font-size:15px}
.so-post{padding:14px 16px;display:grid;gap:8px}
.so-top{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.so-chip{font-size:12px;padding:3px 10px;border-radius:999px;background:var(--tint)}
.so-st{margin-inline-start:auto;font-size:12px}
.so-body{white-space:pre-wrap;margin:0}
.so-up{display:flex;gap:10px;align-items:center;flex-wrap:wrap}.so-up input{margin:0;max-width:100%}
.so-prev{margin:8px 0 0}.so-prev img,.so-prev video{max-width:100%;max-height:220px;border-radius:12px;display:block}
.so-link{margin:8px 0 0}.so-link summary{cursor:pointer;font-size:13px}
.so-note{font-size:13px;margin:8px 0 0;padding:10px 12px;border-radius:12px;background:var(--tint)}
.so-appr{margin-bottom:20px}.so-appr h2{margin:0 0 6px}
.so-warn{color:var(--deep);font-weight:600;font-size:12px}
.so-conn{margin-bottom:20px}.so-conn h2{margin:0 0 6px}.so-conn p{margin:4px 0}
.so-ck{list-style:none;margin:10px 0 0;padding:0;display:grid;gap:6px}.so-ck li{padding:8px 12px;border-radius:12px;background:var(--tint);font-size:13px;display:flex;gap:8px;align-items:flex-start}
.so-ck .block{color:#C0392B;font-weight:600}.so-ck .warn{color:var(--deep);font-weight:600}.so-ck .ok{color:inherit}
.so-pick{display:grid;gap:8px;margin:10px 0}.so-pick label{display:flex;gap:8px;align-items:center;flex-wrap:wrap}
.so-fail{border:1px solid #C0392B55;background:#C0392B0F}.so-fail ul{margin:6px 0 0;padding-inline-start:18px}
.so-more{margin:6px 0 0;font-size:12px}.so-more summary{cursor:pointer}.so-more code{direction:ltr;unicode-bidi:plaintext;display:block;white-space:pre-wrap;word-break:break-word}
</style>
</head>
<body data-page="social" data-module>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <div class="so-grid">
        <section class="card pad">
          <h2>منشور جديد</h2>
          <form id="f" novalidate>
            <label>المنصات</label><div class="checks" id="plats"></div>
            <label for="body">النص</label><textarea id="body" rows="6"></textarea>
            <p class="so-cnt muted" id="cnt"></p>
            <div class="bar"><button class="btn sm secondary" type="button" id="suggest">اكتب لي نص من الفكرة</button></div>
            <label for="file">صورة أو فيديو <span class="muted">(اختياري)</span></label>
            <div class="so-up"><input type="file" id="file" accept="image/jpeg,image/png,image/webp,video/mp4,video/quicktime"><span class="muted" id="upMsg"></span></div>
            <div class="so-prev" id="prev" hidden></div>
            <details class="so-link"><summary class="muted">أو حط رابط</summary><input type="url" id="media" dir="ltr" placeholder="https://"></details>
            <label for="at">وقت النشر <span class="muted">(بتوقيت الرياض)</span></label><input type="datetime-local" id="at" required>
            <p class="so-note" id="who">كل منشور ينتظر اعتماد قبل ما ينشر.</p>
            <div class="bar" style="margin-top:20px"><button class="btn primary" type="submit">جدوِل</button></div>
            <div class="msg" id="msg" role="status"></div>
            <div id="notices"></div>
          </form>
        </section>
        <section>
          <section class="card pad so-conn" id="conn">
            <h2>الحساب المربوط</h2>
            <p id="connNames" class="muted"></p>
            <div id="pick" hidden>
              <p>ربطت ميتا وفيه أكثر من صفحة. اختر الصفحة اللي ينشر عليها:</p>
              <div class="so-pick" id="pickList"></div>
              <div class="bar"><button class="btn sm primary" type="button" id="pickSave">اعتمد هالصفحة</button><span class="msg" id="pickMsg" role="status"></span></div>
            </div>
            <div class="bar" id="connBar" style="margin-top:10px">
              <button class="btn sm secondary" type="button" id="connCheck" hidden>افحص جاهزية النشر</button>
              <a class="btn sm ghost" href="/connectors/" id="connLink" hidden>غيّر الربط</a>
            </div>
            <ul class="so-ck" id="connOut"></ul>
            <div id="eng" hidden style="margin-top:16px">
              <h3 style="margin:0 0 4px;font-size:14px">النشر لتيك توك وX ولينكدإن</h3>
              <p class="muted" style="margin:0 0 8px">يمر بخدمة نشر إضافية، وبعد الاعتماد بس.</p>
              <div class="bar"><button class="btn sm secondary" type="button" id="engCheck">افحص الخدمة والحسابات</button></div>
              <ul class="so-ck" id="engOut"></ul>
            </div>
          </section>
          <section class="card pad so-appr" id="appr" hidden>
            <h2>مين يعتمد النشر</h2>
            <p class="muted" style="margin:0 0 10px">ما ينشر أي منشور إلا بعد اعتماده. بدون اختيار: المالك بس.</p>
            <div class="checks" id="apprList"></div>
            <div class="bar" style="margin-top:12px"><button class="btn sm primary" type="button" id="apprSave">احفظ</button><span class="msg" id="apprMsg" role="status"></span></div>
          </section>
          <div class="bar" style="justify-content:space-between"><h2 style="margin:0">التقويم</h2><span class="muted" id="range"></span></div>
          <div id="list"></div>
        </section>
      </div>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
