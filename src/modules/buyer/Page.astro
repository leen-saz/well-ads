---
import { ClientRouter } from 'astro:transitions';
import Pane from './Pane.astro';
// الميديا باير: توصيات مرتبة من أرقام الإعلانات، وتنفيذ بموافقة لين على كل إجراء (تجربة بدون تنفيذ أول، وزر طوارئ).
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>الميديا باير · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>.by-pane-only{display:none}</style>

</head>
<body data-page="buyer" data-module>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <Pane />
      <section class="card pad" id="by-rulesBox" hidden style="margin:16px 0 0">
        <div class="bar" style="justify-content:space-between;margin:0 0 8px"><h2 style="margin:0">قواعد الشركة</h2><div class="bar"><button class="btn sm secondary" type="button" id="by-rulesExport">تصدير</button><button class="btn sm" type="button" id="by-rulesImport">استيراد القواعد</button></div></div>
        <p class="muted" id="by-rulesInfo" style="margin:0 0 8px"></p>
        <div id="by-rulesForm" hidden>
          <p class="muted" style="margin:0 0 8px">ارفع ملف JSON أو الصق نصه. تنحفظ في قاعدة البيانات فقط، والملف ما يدخل الريبو.</p>
          <input type="file" id="by-rulesFile" accept="application/json,.json" style="margin:0 0 8px">
          <textarea id="by-rulesText" rows="6" dir="ltr" style="width:100%;font:13px var(--f-num,monospace)" placeholder='{"rules":[...]}'></textarea>
          <div class="bar" style="margin:8px 0 0"><button class="btn sm secondary" type="button" id="by-rulesPreview">معاينة</button></div>
          <div id="by-rulesPrev" style="margin:10px 0 0"></div>
        </div>
      </section>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
