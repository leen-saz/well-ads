---
import { ClientRouter } from 'astro:transitions';
// المعرفة: اللي يتعلمه الذكاء الاصطناعي عن الشركة. شات تدريب يسأل سؤال سؤال، وإضافة وتعديل وإيقاف، ومعاينة اللي يوصل لكل موديول.
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>المعرفة · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>
.kn-grid{display:grid;grid-template-columns:minmax(0,400px) minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:1000px){.kn-grid{grid-template-columns:1fr}}
.kn-mods{display:flex;gap:6px 14px;flex-wrap:wrap;margin:4px 0 0;font-size:14px}
.kn-mods label{display:flex;gap:6px;align-items:center;margin:0}
.kn-head{margin:18px 0 8px;font-size:15px}
.kn-head:first-child{margin-top:0}
.kn-e{padding:12px 16px;display:grid;gap:6px;margin:0 0 8px}
.kn-e.off{opacity:.6}
.kn-top{display:flex;gap:8px;flex-wrap:wrap;align-items:center;font-size:13px}
.kn-chip{font-size:12px;padding:2px 10px;border-radius:999px;background:var(--tint)}
.kn-chip.wait{background:color-mix(in srgb,var(--accent) 22%,transparent)}
.kn-body{margin:0;white-space:pre-wrap;font-size:14px}
.kn-act{display:flex;gap:6px;margin-inline-start:auto}
.kn-chat{display:grid;gap:10px;max-width:760px}
.kn-q,.kn-a{padding:10px 14px;border-radius:16px;max-width:85%;white-space:pre-wrap;font-size:14px;margin:0}
.kn-q{background:var(--tint);justify-self:start}
.kn-a{background:color-mix(in srgb,var(--accent) 14%,transparent);justify-self:end}
.kn-a small{display:block;color:var(--muted);font-size:12px;margin-top:4px}
.kn-prog{font-size:13px;margin:0 0 12px}
.kn-thumb{max-width:160px;max-height:120px;border-radius:10px;background:var(--tint);display:block}
.kn-sw{display:flex;gap:6px}.kn-sw i{width:28px;height:28px;border-radius:8px;border:1px solid var(--line)}
.kn-pre{white-space:pre-wrap;font-size:13px;max-height:360px;overflow:auto;padding:12px;border-radius:12px;background:var(--tint);margin:8px 0 0}
</style>
</head>
<body data-page="knowledge" data-module>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <p class="muted" style="margin:0 0 14px">اللي تكتبه هنا يقراه الذكاء الاصطناعي في كل موديول قبل ما يكتب: المحتوى والتصميم والصوت والسوشال. شات التدريب يسألك سؤال سؤال لين تكتمل المعرفة، وكل جواب ينحفظ وتقدر تعدّله من «كل المعرفة». اللي يضيفه أحد بدون صلاحية موافقة يبقى موقوف لين يعتمده المدير.</p>
      <div class="seg" role="group" aria-label="العرض" style="margin:0 0 14px"><button type="button" data-tab="train" aria-pressed="true">شات التدريب</button><button type="button" data-tab="all" aria-pressed="false">كل المعرفة</button><button type="button" data-tab="brand" aria-pressed="false">الهوية والبصريات</button></div>
      <section id="train" class="card pad">
        <p class="muted kn-prog" id="prog"></p>
        <div class="kn-chat" id="chat"><div class="sk" style="height:44px;max-width:420px" aria-hidden="true"></div><p class="muted">يحمّل…</p></div>
        <form id="tf" novalidate style="margin-top:14px;max-width:760px" hidden>
          <label for="ans">جوابك</label><textarea id="ans" rows="4" dir="auto" maxlength="2000"></textarea>
          <div class="bar" style="margin-top:10px"><button class="btn primary" type="submit" id="send">أرسل</button><button class="btn" type="button" id="skip">تخطَّ السؤال</button></div>
          <div class="msg" id="tmsg" role="status"></div>
        </form>
        <div id="tcomp" style="max-width:760px"></div>
      </section>
      <div class="kn-grid" id="brand" hidden>
        <section class="card pad">
          <h2 style="margin:0 0 4px">ملفات الهوية</h2>
          <p class="muted" style="margin:0 0 10px;font-size:13px">التصميم يستخدم الفعّال منها تلقائياً كل مرة: الشعار، الألوان، الخط، والصور المرجعية.</p>
          <form id="bf" novalidate>
            <label for="bkind">النوع</label><select id="bkind"></select>
            <label for="btitle">الاسم <span class="muted">(اختياري)</span></label><input type="text" id="btitle" maxlength="120">
            <label for="bfile">الملف</label><input type="file" id="bfile">
            <p class="muted" id="bhint" style="margin:4px 0 0;font-size:13px"></p>
            <div class="bar" style="margin-top:12px"><button class="btn primary" type="submit" id="bsave">ارفع</button></div>
          </form>
          <form id="cf" novalidate style="margin-top:18px">
            <label for="colors">ألوان العلامة <span class="muted">(hex، الأساسي أول ثم المميز)</span></label><input type="text" id="colors" dir="ltr" placeholder="#1D1069 #7E57FD #F6F0E3">
            <div class="bar" style="margin-top:10px"><button class="btn" type="submit">احفظ الألوان</button></div>
          </form>
          <div class="msg" id="bmsg" role="status"></div>
        </section>
        <section id="blist"><div class="sk" style="height:120px" aria-hidden="true"></div><p class="muted" style="margin-top:8px">يحمّل…</p></section>
      </div>
      <div class="kn-grid" id="all" hidden>
        <section class="card pad">
          <h2 id="ftitle" style="margin:0 0 8px">أضف معرفة</h2>
          <form id="f" novalidate>
            <input type="hidden" id="id">
            <label for="kind">النوع</label><select id="kind"></select>
            <p class="muted" id="hint" style="margin:4px 0 0;font-size:13px"></p>
            <label for="title">العنوان <span class="muted">(اختياري)</span></label><input type="text" id="title" maxlength="120">
            <label for="body">المحتوى</label><textarea id="body" rows="5" dir="auto" maxlength="2000"></textarea>
            <div id="pricebox"><label for="price">السعر بالريال <span class="muted">(اختياري)</span></label><input type="number" id="price" min="0" step="1" inputmode="decimal"></div>
            <label>يطبّق على <span class="muted">(ما تختار شي = كل الموديولات)</span></label><div class="kn-mods" id="mods"></div>
            <div class="bar" style="margin-top:16px"><button class="btn primary" type="submit" id="save">احفظ</button><button class="btn" type="button" id="cancel" hidden>إلغاء التعديل</button></div>
            <div class="msg" id="msg" role="status"></div>
          </form>
          <div id="comp"></div>
          <h3 style="margin:20px 0 4px">وش يوصل للذكاء الاصطناعي</h3>
          <div class="bar"><select id="pv" aria-label="الموديول"></select><button class="btn" type="button" id="pvgo">اعرض</button></div>
          <pre class="kn-pre" id="pvout" hidden></pre>
        </section>
        <section id="list"><div class="sk" style="height:160px" aria-hidden="true"></div><p class="muted" style="margin-top:8px">يحمّل…</p></section>
      </div>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
