---
import { ClientRouter } from 'astro:transitions';
// «تدقيق القرارات»: owner only (the gate and the API ask for the owner), under «المدير». Read only. It re-checks the verdicts the
// marketing judge shows, on the same data, and says for each: confirmed, weakened or contradicted, and what would settle it.
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>تدقيق القرارات · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>
.au-bar{display:flex;flex-wrap:wrap;gap:8px;align-items:center;margin:0 0 12px}
.au-sec{margin:0 0 16px}.au-sec h2{margin:0 0 4px}
.au-st{display:inline-block;padding:3px 10px;border-radius:999px;font-size:13px;font-weight:700}
.au-st.confirmed{background:#E6F4EC;color:#1E6B45}.au-st.weakened{background:#FFF3D6;color:#7A5200}.au-st.contradicted{background:#FBEAE7;color:#8A2A1B}
.au-find{margin:10px 0 0;padding:10px 12px;border-radius:12px;background:var(--tint);font-size:14px}
.au-find.contradicts{background:#FBEAE7;color:#8A2A1B}.au-find.weakens{background:#FFF3D6;color:#7A5200}
.au-find small{display:block;margin-top:4px;color:var(--muted)}
.au-kpis{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:12px;margin:12px 0}
.au-kpi{padding:12px 14px}.au-kpi b{display:block;font:700 24px var(--f-num)}.au-kpi span{color:var(--muted);font-size:13px}
.au-tbl{width:100%;border-collapse:collapse;font-size:14px}
.au-tbl th,.au-tbl td{padding:6px 8px;text-align:start;border-bottom:1px solid var(--line);vertical-align:top}
.au-tbl-wrap{overflow-x:auto}
.au-draft{display:inline-block;padding:2px 8px;border-radius:999px;background:var(--tint);font-size:12px;font-weight:700;margin-inline-start:6px}
</style>
</head>
<body data-page="audit" data-module>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <p class="muted" style="margin:0 0 12px"><a href="/maestro/" id="auBack">← المدير</a> · <span id="auNote">قراءة فقط. بدون أسماء أو جوالات.</span></p>
      <div id="sections"><p class="muted">جاري التحميل…</p></div>
      <div class="msg" id="msg" role="status"></div>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
