---
import { NAV, CONTACT, wa } from '../../lib/public-site';
---
<footer class="st-foot">
  <div class="st-wrap">
    <div>
      <span class="mark">Apipeline<i>.</i></span>
      <p>شركة سعودية تبني لوحة قرارات تسويقية، وتفحص أمن الأكواد والمواقع والتطبيقات.</p>
    </div>
    <nav aria-label="روابط">
      {NAV.map(n => <a href={n.href}>{n.label}</a>)}
      <a href="/login/">دخول</a>
    </nav>
    {CONTACT.whatsapp && <a class="st-wa" href={wa('السلام عليكم، أبي أعرف أكثر عن Apipeline')} rel="noopener" target="_blank"><span dir="ltr">{CONTACT.phoneLabel}</span> · واتساب</a>}
    <small>© ٢٠٢٦ Apipeline</small>
  </div>
</footer>
