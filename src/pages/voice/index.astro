---
// One tab, four sections: ?tab=voiceover, ?tab=transcribe or ?tab=video shows that module's page (its own access and lock are checked in src/lib/gate.ts)
import Page from '../../modules/voice/Page.astro';
import Voiceover from '../../modules/voiceover/Page.astro';
import Transcribe from '../../modules/transcribe/Page.astro';
import Video from '../../modules/video/Page.astro';
const tab = Astro.url.searchParams.get('tab');
---
{tab === 'voiceover' ? <Voiceover /> : tab === 'transcribe' ? <Transcribe /> : tab === 'video' ? <Video /> : <Page />}
