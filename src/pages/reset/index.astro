<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>باسوورد جديد · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&display=swap">
<link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<main class="auth"><div class="card">
  <div class="bar" style="justify-content:space-between;margin-bottom:28px"><span class="mark" style="margin:0">Well<i>.</i></span><span id="lang"></span></div>
  <h1>باسوورد جديد</h1>
  <p class="muted" style="margin:0">10 أحرف أو أكثر.</p>
  <form id="f" novalidate>
    <label for="p1">الباسوورد الجديد</label><input type="password" id="p1" autocomplete="new-password" required>
    <label for="p2">أعد كتابته</label><input type="password" id="p2" autocomplete="new-password" required>
    <div class="actions"><button class="btn primary" type="submit">احفظ</button></div>
    <div class="msg" id="msg" role="status"></div>
  </form>
</div></main>
<script is:inline type="module" src="/assets/reset.js"></script>
