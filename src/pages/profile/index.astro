---
// Apipeline company profile: one page that reads as a scroll story on screen and prints as an A4 PDF
// (site.css @media print, the "حمّل PDF" button calls window.print). Open without login (src/lib/gate.ts).
// Only facts the product shows: counts of agents, platforms and steps come from the welcome page's lists.
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import RequestForm from '../../components/site/RequestForm.astro';


const VALUES = [
  ['الوضوح', 'رقم واحد يفهمه الكل أفضل من عشرين رقم ما أحد يقراها.'],
  ['القرار للإنسان', 'الأنظمة تقترح وتجهّز، والشخص المسؤول هو اللي يعتمد.'],
  ['الأمان أولًا', 'صلاحيات أقل، وسجل لكل خطوة، وزر يوقف كل شي.'],
  ['الصدق في الأرقام', 'ما نعرض رقم ما نقدر نثبته، ولا نوعد بنتيجة ما نتحكم فيها.'],
];

const LINES = [
  ['لوحة Apipeline', 'منصة', 'أرقام كل منصات الإعلان في لوحة وحدة، تتحدّث كل ساعة، وتسعة إيجنتس تقترح القرار وتنفّذه بعد موافقتك.', ['مزامنة Meta وGoogle وSnapchat وTikTok وGA4', 'لوحة قرارات بموافقة وتعديل ورفض', 'مراجع يفحص كل اقتراح على قواعدك', 'سجل كامل وزر طوارئ'], '/welcome/'],
  ['خريطة التسرب', 'خدمة نمو', 'قبل ما تزيد الميزانية، نحدد وين يضيع العميل بين الإعلان والمبيعات، ونرتب الإصلاحات حسب أثرها.', ['مراجعة الإنفاق وجودة الليدز', 'تحديد نقطة التسرب: إعلان، عرض، صفحة، أو متابعة', 'خطة ٩٠ يوم بقرارات واضحة', 'ربط الحملات بالمبيعات'], ''],
  ['الأمن السيبراني', 'خدمة فحص', 'فحص أمني للكود والمواقع والـ API وتطبيقات الجوال، مع تقرير مرتب حسب الخطورة وإعادة فحص بعد الإصلاح.', ['مراجعة الكود والمكتبات والأسرار', 'اختبار اختراق للويب والجوال', 'مراجعة إعدادات السحابة', 'ربط النتائج بضوابط ECC وPDPL'], '/security/'],
];

const HOW = [
  ['نقرا', 'نفهم نشاطك وأرقامك وأنظمتك كما هي، قبل أي اقتراح.'],
  ['نحدد', 'نرتب المشاكل حسب أثرها الفعلي، مو حسب سهولتها.'],
  ['ننفّذ', 'نصلح ونقيس، وكل تغيير موثّق وتقدر ترجع عنه.'],
  ['نتعلّم', 'كل نتيجة تدخل في القرار اللي بعده.'],
];

const FIT = [
  'عندك إنفاق إعلاني قائم أو قرار جاد بالاستثمار فيه',
  'عندك منتج رقمي، موقع أو تطبيق، وتبي تعرف وضعه الأمني',
  'مستعد تشارك البيانات وتتعامل مع الأرقام بوضوح',
  'تبي تحسين فعلي، مو تقرير نهاية الشهر',
];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>Apipeline · بروفايل الشركة</title>
<meta name="description" content="بروفايل Apipeline: من نحن، وش نقدّم، وكيف نشتغل.">
<link rel="preload" href="/assets/fonts/thmanyahserifdisplay-Black.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<link rel="stylesheet" href="/assets/site.css">
<style is:global>
.pf-cover{min-height:calc(100svh - 68px);display:flex;flex-direction:column;justify-content:center;padding-block:64px}
.pf-cover .mark{font-size:clamp(64px,13vw,168px);line-height:1;display:block;margin:0 0 28px}
.pf-cover .yr{font:500 15px/1 var(--f-ar);color:var(--muted);letter-spacing:.02em;margin:0 0 18px}
.pf-cover h1{font:700 clamp(26px,3.4vw,44px)/1.35 var(--f-display);max-width:20em;margin:0 0 32px;text-wrap:balance}
.pf-vm{display:grid;grid-template-columns:1fr 1fr;gap:18px}
.pf-vm h3{font:700 15px/1 var(--f-ar);color:var(--accent);margin:0 0 12px}
.pf-vm p{font:700 clamp(20px,2.2vw,26px)/1.5 var(--f-display);margin:0}
.pf-line{display:grid;grid-template-columns:.9fr 1.1fr;gap:40px;align-items:start;padding:44px 0;border-top:1px solid var(--line)}
.pf-line h3{font:900 clamp(30px,3.6vw,46px)/1.15 var(--f-display);margin:10px 0 14px}
.pf-line p{font:400 17px/1.85 var(--f-text);color:var(--muted);margin:0 0 18px}
.pf-line ul{list-style:none;margin:0;padding:0;display:grid;gap:10px}
.pf-line li{display:flex;gap:12px;align-items:baseline;padding:14px 18px;background:var(--surface);border-radius:var(--r-sm);box-shadow:var(--shadow);font:400 15px/1.6 var(--f-ar)}
.pf-line li::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--accent);flex:none;transform:translateY(-2px)}
.pf-how{display:grid;grid-template-columns:repeat(4,1fr);gap:18px;counter-reset:h}
.pf-how div{counter-increment:h}
.pf-how div::before{content:counter(h,arabic-indic);display:block;font:900 56px/1 var(--f-display);color:var(--soft);margin:0 0 12px}
[dir="ltr"] .pf-how div::before{content:counter(h)}
.pf-how h3{font:700 22px/1.3 var(--f-display);margin:0 0 8px}
.pf-how p{font:400 15px/1.8 var(--f-text);color:var(--muted);margin:0}
.pf-fit{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:1fr 1fr;gap:12px}
.pf-fit li{padding:18px 20px;border-radius:var(--r-sm);border:1px solid var(--line);font:400 16px/1.7 var(--f-ar)}
@media (max-width:960px){.pf-vm,.pf-line,.pf-fit{grid-template-columns:1fr}.pf-how{grid-template-columns:1fr 1fr}}
@media (max-width:640px){.pf-how{grid-template-columns:1fr}}
@media print{.pf-cover{min-height:auto;padding:40mm 0 0}.pf-line li{box-shadow:none;border:1px solid #DDD6F6}}
</style>
</head>
<body class="st">

<SiteHeader current="/profile/" cta={{ href: '#request', label: 'تواصل معنا' }} />

<main>
  <section class="st-wrap pf-cover st-page">
    <p class="yr">بروفايل الشركة · ٢٠٢٦</p>
    <span class="mark">Apipeline<i>.</i></span>
    <h1>نحوّل أرقام التسويق لقرارات واضحة، ونفحص أمن المنتجات الرقمية قبل ما تنطلق.</h1>
    <div class="st-cta">
      <button class="btn primary" type="button" data-print>حمّل البروفايل PDF</button>
      <a class="btn secondary" href="#lines">وش نقدّم</a>
    </div>
  </section>

  <section class="st-words-sec">
    <div class="st-wrap">
      <p class="st-words" data-words>Apipeline شركة سعودية تقنية. بدأنا من سؤال بسيط يتكرر في كل شركة: وين راحت الميزانية، ووش نسوي بكرة؟ اليوم نبني الأدوات اللي تجاوب عليه، ونحمي المنتجات اللي تعتمد عليها.</p>
    </div>
  </section>

  <section class="st-sec st-page" style="padding-top:0">
    <div class="st-wrap">
      <div class="pf-vm">
        <article class="st-tile" data-reveal><h3>رؤيتنا</h3><p>كل قرار تسويقي في المنطقة مبني على رقم واضح، وكل منتج رقمي مفحوص قبل ما يوصل للناس.</p></article>
        <article class="st-tile" data-reveal><h3>رسالتنا</h3><p>نجمع الأرقام، نقترح القرار، ونترك الاعتماد لصاحبه. ونلقى الثغرة قبل لا يلقاها غيرك.</p></article>
      </div>
      <header class="st-head" style="margin-top:96px" data-reveal>
        <span class="kick">قيمنا</span>
        <h2>أربع قواعد نشتغل عليها</h2>
      </header>
      <div class="st-grid four">
        {VALUES.map(([t, d]) => <article class="st-tile" data-reveal><h3>{t}</h3><p>{d}</p></article>)}
      </div>
    </div>
  </section>

  <section class="st-sec st-dark">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">بالأرقام</span>
        <h2>اللي في المنتج اليوم</h2>
      </header>
      <div class="st-nums">
        <div data-reveal><b data-count="9">٩</b><span>إيجنتس، كل واحد بشغلة واضحة</span></div>
        <div data-reveal><b data-count="10">١٠</b><span>منصات يقرا منها</span></div>
        <div data-reveal><b data-count="24">٢٤</b><span>مزامنة في اليوم، كل ساعة</span></div>
        <div data-reveal><b data-count="5">٥</b><span>خطوات في كل قرار، من الرقم للدرس</span></div>
      </div>
    </div>
  </section>

  <section class="st-sec st-page" id="lines">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">وش نقدّم</span>
        <h2>ثلاث خطوط، وطريقة شغل وحدة</h2>
      </header>
      {LINES.map(([t, tag, d, list, href]) => (
        <article class="pf-line" data-reveal>
          <div>
            <span class="st-chip">{tag}</span>
            <h3>{t}</h3>
            <p>{d}</p>
            {href && <a class="btn secondary sm st-noprint" href={href as string}>اعرف أكثر</a>}
          </div>
          <ul>{(list as string[]).map(x => <li>{x}</li>)}</ul>
        </article>
      ))}
    </div>
  </section>

  <section class="st-sec" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">كيف نشتغل</span>
        <h2>ما نعدّل شي قبل ما نعرف وين الخلل</h2>
      </header>
      <div class="pf-how">
        {HOW.map(([t, d]) => <div data-reveal><h3>{t}</h3><p>{d}</p></div>)}
      </div>
    </div>
  </section>

  <section class="st-sec st-page" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">لمن</span>
        <h2>نناسبك إذا تبي تعرف الحقيقة قبل ما تقرر</h2>
      </header>
      <ul class="pf-fit">
        {FIT.map(x => <li data-reveal>{x}</li>)}
      </ul>
    </div>
  </section>

  <div class="st-noprint"><RequestForm kind="board" title="خلنا نبدأ من أرقامك" lead="اختر وش تحتاج: تجربة اللوحة، أو خريطة التسرب لإعلاناتك، أو فحص أمني لمنتجك. ونرد عليك خلال يوم عمل." /></div>
</main>

<SiteFooter />

<script is:inline type="module" src="/assets/welcome.js"></script>
<script>
  import '../../lib/scroll-story';
  import '../../lib/request-form';
  // Print the profile: everything shown first (the reveals may not have run yet below the fold)
  document.querySelector('[data-print]')?.addEventListener('click', () => {
    document.querySelectorAll<HTMLElement>('[data-reveal]').forEach(el => { el.style.opacity = '1'; el.style.visibility = 'visible'; el.style.transform = 'none'; });
    window.print();
  });
</script>
</body>
</html>
