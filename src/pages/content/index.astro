---
// One tab, two sections: ?tab=copy shows the copy module's page (its own access and lock are checked in src/lib/gate.ts)
import Page from '../../modules/content/Page.astro';
import Section from '../../modules/copy/Page.astro';
const section = Astro.url.searchParams.get('tab') === 'copy';
---
{section ? <Section /> : <Page />}
