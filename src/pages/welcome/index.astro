---
// Public landing page for the Apipeline board, told as a scroll story. Open without login (PUBLIC in src/lib/gate.ts).
// Copy: .claude/skills/apipeline-saudi-voice (Saudi white dialect for titles, light MSA for detail; no superlatives,
// no testimonials, demo numbers labelled). Motion: src/lib/scroll-story.ts. Styles: /assets/site.css on app.css tokens.
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';

const ar = (n: number) => n.toLocaleString('ar-SA');
const LOGOS = ['meta', 'googleads', 'snapchat', 'tiktok', 'googleanalytics', 'x', 'pinterest', 'reddit', 'googlesearchconsole', 'posthog'];

const STEPS = [
  ['يسحب', 'كل منصاتك، صورة وحدة', 'كل ساعة يجيب أرقام Meta وGoogle وSnapchat وTikTok وGA4 لنفس اللوحة. بدون ملفات تصدير، وبدون نسخ ولصق.'],
  ['يقترح', 'الأرقام تتحوّل لقرار', 'إيقاف إعلان يصرف بلا نتيجة، رفع ميزانية اللي تكلفته تحت الهدف، أو مادة إعلانية جديدة.'],
  ['يراجع', 'قواعدك قبل أي خطوة', 'المراجع يفحص كل اقتراح على قواعدك وحدود ميزانيتك، واللي ما يطابق ما ينتقل للتنفيذ.'],
  ['تعتمد', 'أنت صاحب القرار', 'موافقة، تعديل، أو رفض بسبب. في وضع الموافقة ما يتنفّذ شي بدونك.'],
  ['يتعلّم', 'كل نتيجة، درس جديد', 'يقيس نتيجة كل قرار بعد التنفيذ، ويطلع منه درس يستخدمه في الاقتراح الجاي.'],
];

const AGENTS = [
  ['الإيجنتس', 'المدير', 'يوزّع المهام على الإيجنتس ويجمع موافقاتك في مكان واحد.'],
  ['الإيجنتس', 'التتبع', 'منصة وقفت أرقامها، أو ليدز بدون رقم إعلان. كل مشكلة معها حلها.'],
  ['الإيجنتس', 'الامتثال', 'يفحص النص على قواعد وزارة الصحة والمنصات، وينبّهك بس.'],
  ['الإيجنتس', 'الرصد', 'وش يشد الناس في منشوراتك ومنشورات منافسينك.'],
  ['الإيجنتس', 'التصميم', 'مقاسات جاهزة لكل منصة، والنص دايم طبقة فوق الصورة.'],
  ['الإيجنتس', 'الصوت', 'نص الفويس أوفر بطول الإعلان، وتسمعه بصوت عربي.'],
  ['النمو', 'السوشال', 'منشور واحد لكذا منصة، بجدولة وموافقة.'],
  ['النمو', 'الرحلات والرسائل', 'رحلات واتساب وإيميل تمشي لحالها.'],
  ['النمو', 'المحتوى و SEO', 'يحلل موقعك ويبني خطة، وتوافق على كل بند.'],
];

const RULES = [
  ['قراءة بس', 'حسابات الإعلانات ما تتعدّل إلا داخل حملات التجربة اللي تحددها أنت.', 'M2 12s3.6-7 10-7 10 7 10 7-3.6 7-10 7S2 12 2 12Z M12 9a3 3 0 1 0 0 6 3 3 0 0 0 0-6Z'],
  ['زر طوارئ', 'ضغطة وحدة توقف كل تنفيذ، وكل خطوة لها إيصال في السجل.', 'M12 2v10 M18.4 6.6a9 9 0 1 1-12.8 0'],
  ['كل شركة لحالها', 'بياناتك معزولة عن غيرك من أول جدول.', 'M5 11h14v10H5z M8 11V7a4 4 0 0 1 8 0v4'],
  ['تلقائي أو يدوي', 'لكل إيجنت تختار: يمشي لحاله، أو ينتظر موافقتك مع تنبيه.', 'M4 6h10 M18 6h2 M4 12h4 M12 12h8 M4 18h12 M20 18h0 M16 4v4 M10 10v4 M18 16v4'],
];

const FAQ = [
  ['هل يتنفّذ شي بدون موافقتي؟', 'لا في وضع الموافقة. كل اقتراح يوصلك مع أرقامه وسبب المراجع، وما يتحرك إلا بعد ما توافق. وتقدر تخلي إيجنت معيّن يمشي تلقائيًا داخل حدود تحددها أنت.'],
  ['وش المنصات اللي يقرا منها؟', 'Meta وGoogle Ads وSnapchat وTikTok وGA4، مع X وPinterest وReddit وSearch Console. كل ربط يتم بتسجيل الدخول في المنصة نفسها.'],
  ['وين تنحفظ بياناتي؟', 'بيانات كل شركة معزولة عن غيرها، ومفاتيح الربط محفوظة في خزنة مشفّرة. وتقدر تفك أي ربط بضغطة وتنمسح مفاتيحه.'],
  ['هل يغني عن فريق التسويق؟', 'لا. يختصر على فريقك جمع الأرقام والمتابعة اليومية، ويخلي وقتهم للقرار والإبداع. القرار الأخير دايم عند شخص.'],
];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>Apipeline · لوحة التسويق</title>
<meta name="description" content="أرقام كل منصات إعلاناتك في لوحة وحدة، وإيجنتس تقترح وتنفّذ بعد موافقتك.">
<link rel="preload" href="/assets/fonts/thmanyahserifdisplay-Black.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body class="st">

<SiteHeader current="/welcome/" cta={{ href: '/login/', label: 'دخول' }} />

<main>
  <section class="st-wrap st-hero">
    <div>
      <p class="st-eyebrow">لوحة تسويق بإيجنتس، والقرار الأخير لك</p>
      <h1 class="st-h1">الأرقام تتكلم. <em>والقرار لك.</em></h1>
      <p class="st-lead">Apipeline يجمع أرقام منصاتك كل ساعة، ويقترح وش توقف ووش ترفع، ويفحص المراجع كل اقتراح على قواعدك قبل ما يوصلك. توافق، ويتنفّذ بأمان.</p>
      <div class="st-cta">
        <a class="btn primary" href="/login/">ادخل للوحة</a>
        <a class="btn secondary" href="#how">شوف كيف يشتغل</a>
      </div>
      <p class="st-note">الأرقام في الأمثلة بيانات تجريبية.</p>
    </div>

    <div class="st-stack" role="img" aria-label="مثال من لوحة القرارات">
      <article class="st-card" style="inset-inline-start:0;top:24px;width:min(100%,430px);z-index:3" data-depth="0.08">
        <span class="k">اقتراح · Meta</span>
        <h3>إيقاف إعلان يصرف ٣ أيام بدون ولا ليد</h3>
        <dl class="st-stats">
          <div><dt>الصرف</dt><dd>٨٤٠ ر.س</dd></div>
          <div><dt>الليدز</dt><dd>٠</dd></div>
          <div><dt>نسبة النقر</dt><dd>٠٫٤٪</dd></div>
        </dl>
        <div class="st-acts"><span class="btn primary">موافقة</span><span class="btn secondary">تعديل</span><span class="btn ghost">رفض</span></div>
      </article>
      <article class="st-card" style="inset-inline-end:0;top:250px;width:min(88%,360px);z-index:2" data-depth="0.22">
        <span class="k">اقتراح · Snapchat</span>
        <h3>رفع ميزانية مجموعة تكلفتها تحت الهدف بـ ٣٢٪</h3>
        <span class="st-chip ok">المراجع: مطابق لقواعدك</span>
      </article>
      <article class="st-card" style="inset-inline-start:6%;top:410px;z-index:4;padding:12px 14px" data-depth="0.4">
        <span class="st-chip hot">زر الطوارئ</span>
      </article>
    </div>
  </section>

  <section class="st-logos" aria-label="المنصات">
    <p>يقرا من منصاتك</p>
    <div class="st-marquee" aria-hidden="true">
      {[...LOGOS, ...LOGOS].map(l => <span style={`--src:url(/assets/logos/${l}.svg)`}></span>)}
    </div>
  </section>

  <section class="st-words-sec">
    <div class="st-wrap">
      <p class="st-words" data-words>الصرف في Meta، والليدز في ملف إكسل، والمبيعات في واتساب. كل منصة تقول قصة، وما أحد يقول لك وش تسوي بكرة الصبح. Apipeline يجمعها في لوحة وحدة، ويحط القرار قدامك.</p>
    </div>
  </section>

  <section class="st-sec" id="how" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">كيف يشتغل</span>
        <h2>دورة وحدة تمشي كل ساعة</h2>
        <p>من الرقم للقرار للدرس، وأنت في النص. كل خطوة مسجلة وتقدر ترجع عنها.</p>
      </header>
      <div class="st-steps" data-steps>
        <div class="st-steps-visual" data-steps-visual aria-hidden="true">
          <div class="st-panel">
            <span class="k st-chip">آخر مزامنة الآن</span>
            <ul>
              <li>Meta Ads<b>١٢:٠٠</b></li><li>Google Ads<b>١٢:٠٠</b></li><li>Snapchat<b>١٢:٠٠</b></li><li>TikTok<b>١٢:٠٠</b></li><li>GA4<b>١٢:٠٠</b></li>
            </ul>
          </div>
          <div class="st-panel">
            <span class="k" style="color:var(--accent);font:500 12px/1 var(--f-ar)">اقتراح · Meta</span>
            <h3 style="font:700 20px/1.5 var(--f-ar);margin:0">إيقاف إعلان يصرف ٣ أيام بدون ولا ليد</h3>
            <dl class="st-stats"><div><dt>الصرف</dt><dd>٨٤٠ ر.س</dd></div><div><dt>الليدز</dt><dd>٠</dd></div><div><dt>نسبة النقر</dt><dd>٠٫٤٪</dd></div></dl>
          </div>
          <div class="st-panel">
            <ul>
              <li>داخل حملة تجربة<b>✓</b></li><li>داخل حدود الميزانية<b>✓</b></li><li>مطابق لقواعد المنصة<b>✓</b></li><li>بدون كلمات ممنوعة<b>✓</b></li>
            </ul>
            <span class="st-chip ok">اجتاز المراجعة</span>
          </div>
          <div class="st-panel">
            <span class="st-chip">بانتظار موافقتك</span>
            <h3 style="font:700 20px/1.5 var(--f-ar);margin:0">إيقاف إعلان يصرف ٣ أيام بدون ولا ليد</h3>
            <div class="st-acts"><span class="btn primary">موافقة</span><span class="btn secondary">تعديل</span><span class="btn ghost">رفض</span></div>
          </div>
          <div class="st-panel">
            <span class="big">درس محفوظ</span>
            <p style="margin:0;color:var(--muted);font:400 16px/1.8 var(--f-text)">بعد التنفيذ يقيس الأثر ويحفظ النتيجة، عشان الاقتراح الجاي يبدأ من اللي تعلّمه.</p>
          </div>
        </div>
        <div class="st-steps-list">
          <span class="st-steps-line" data-steps-line aria-hidden="true"></span>
          <ol style="list-style:none;margin:0;padding:0">
            {STEPS.map(([n, h, p], i) => <li class="st-step" data-step><p class="n">{`${ar(0)}${ar(i + 1)} · ${n}`}</p><h3>{h}</h3><p>{p}</p></li>)}
          </ol>
        </div>
      </div>
    </div>
  </section>

  <section class="st-hs" id="agents" data-hscroll>
    <div class="st-hs-in">
      <div class="st-wrap">
        <header class="st-head">
          <span class="kick">الإيجنتس</span>
          <h2>تسع تابات، كل وحدة إيجنت بشغلة واضحة</h2>
          <p>كلها تصب في لوحة القرارات نفسها، والمدير يديرها.</p>
        </header>
      </div>
      <div class="st-track" data-track>
        {AGENTS.map(([g, n, d], i) => <article class="st-agent"><span class="g">{g}</span><h3>{n}</h3><p>{d}</p><span class="ix" aria-hidden="true">{`${ar(0)}${ar(i + 1)}`}</span></article>)}
      </div>
    </div>
  </section>

  <section class="st-sec st-dark" id="safety">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">الأمان</span>
        <h2>قواعد ما تنكسر</h2>
        <p>النظام يقترح وينفّذ، بس داخل حدود أنت ترسمها.</p>
      </header>
      <div class="st-grid four">
        {RULES.map(([t, d, p]) => <article class="st-tile" data-reveal><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={p}/></svg></span><h3>{t}</h3><p>{d}</p></article>)}
      </div>
    </div>
  </section>

  <section class="st-sec">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">من Apipeline</span>
        <h2>نفس الدقة، على أمن منتجاتك</h2>
        <p>نفحص أكوادك ومواقعك وتطبيقاتك، ونسلّمك كل ثغرة مع طريقة إصلاحها.</p>
      </header>
      <div class="st-grid two">
        <a class="st-tile" href="/security/" style="text-decoration:none" data-reveal>
          <span class="st-chip">الأمن السيبراني</span>
          <h3>فحص أمني للأكواد والمواقع والتطبيقات</h3>
          <p>مراجعة كود، اختبار اختراق للويب والجوال، وتقرير مرتب حسب الخطورة مع إعادة فحص بعد الإصلاح.</p>
        </a>
        <a class="st-tile" href="/profile/" style="text-decoration:none" data-reveal>
          <span class="st-chip">من نحن</span>
          <h3>بروفايل Apipeline</h3>
          <p>من نحن، وش نقدّم، وكيف نشتغل. وتقدر تحفظه PDF من المتصفح.</p>
        </a>
      </div>
    </div>
  </section>

  <section class="st-sec" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal><span class="kick">أسئلة</span><h2>قبل ما تبدأ</h2></header>
      <div class="st-faq">
        {FAQ.map(([q, a]) => <details data-reveal><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="st-end">
    <div class="st-wrap" data-reveal>
      <h2>اربط حساباتك وخل الأرقام تتكلم</h2>
      <p>كل ربط بتسجيل دخول المنصة نفسها. بدون ملفات تصدير، وبدون لصق مفاتيح.</p>
      <div class="st-cta"><a class="btn primary" href="/login/">ادخل للوحة</a></div>
    </div>
  </section>
</main>

<SiteFooter />

<script is:inline type="module" src="/assets/welcome.js"></script>
<script>import '../../lib/scroll-story';</script>
</body>
</html>
