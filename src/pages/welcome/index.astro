---
// Public landing page that explains the system. Open without login (PUBLIC in src/lib/gate.ts).
// Brand: Apipeline wordmark on the app theme. Copy follows the MOH rules: no superlatives, no testimonials, no claims we can't show.
const LOGOS = ['meta', 'googleads', 'snapchat', 'tiktok', 'googleanalytics', 'x', 'pinterest', 'reddit', 'googlesearchconsole', 'posthog'];

const LOOP = [
  ['يسحب', 'كل ساعة يجيب أرقام Meta وGoogle وSnapchat وTikTok وGA4 لنفس اللوحة.'],
  ['يقترح', 'إيقاف إعلان يصرف بلا نتيجة، رفع ميزانية اللي تكلفته تحت الهدف، أو مادة إعلانية جديدة.'],
  ['يراجع', 'المراجع يفحص كل اقتراح على قواعدك، واللي ما يطابق ما ينقبل.'],
  ['تعتمد', 'موافقة، تعديل، أو رفض بسبب. ما يتنفّذ شي بدونك.'],
  ['يتعلّم', 'يقيس نتيجة كل قرار بعد التنفيذ ويطلع منه درس للمرة الجاية.'],
];

const GROUPS = [
  { title: 'النمو', items: [
    ['السوشال', 'منشور واحد لكذا منصة، بجدولة وموافقة.'],
    ['الرحلات والرسائل', 'رحلات واتساب وإيميل تمشي لحالها.'],
    ['المحتوى و SEO', 'يحلل موقعك ويبني خطة، وتوافق على كل بند.'],
  ]},
  { title: 'الإيجنتس', items: [
    ['المدير', 'يوزّع المهام على الإيجنتس ويجمع موافقاتك في مكان واحد.'],
    ['التتبع', 'منصة وقفت أرقامها، أو ليدز بدون رقم إعلان. كل مشكلة معها حلها.'],
    ['الامتثال', 'يفحص النص على قواعد وزارة الصحة والمنصات، وينبّهك بس.'],
    ['الرصد', 'وش يشد الناس في منشوراتك ومنشورات منافسينك.'],
    ['التصميم', 'مقاسات جاهزة لكل منصة، والنص دايم طبقة فوق الصورة.'],
    ['الصوت', 'نص الفويس أوفر بطول الإعلان، وتسمعه بصوت عربي.'],
  ]},
];

const RULES = [
  ['قراءة بس', 'حسابات الإعلانات ما تتعدّل إلا داخل حملات التجربة اللي تحددها أنت.'],
  ['زر طوارئ', 'ضغطة وحدة توقف كل تنفيذ، وكل خطوة لها إيصال في السجل.'],
  ['كل شركة لحالها', 'بياناتك معزولة عن غيرك من أول جدول.'],
  ['تلقائي أو يدوي', 'لكل إيجنت تختار: يمشي لحاله، أو ينتظر موافقتك مع تنبيه.'],
];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>Apipeline · لوحة التسويق</title>
<meta name="description" content="أرقام كل منصات إعلاناتك في لوحة وحدة، وإيجنتس تقترح وتنفّذ بعد موافقتك.">
<link rel="preload" href="/assets/fonts/thmanyahserifdisplay-Bold.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<style is:global>
.lp{--wrap:1120px;--gut:clamp(16px,4vw,40px)}
.lp-wrap{max-width:var(--wrap);margin:0 auto;padding:0 var(--gut)}
.lp-top{position:sticky;top:0;z-index:5;background:color-mix(in srgb,var(--bg) 86%,transparent);-webkit-backdrop-filter:blur(12px);backdrop-filter:blur(12px)}
.lp-top .lp-wrap{display:flex;align-items:center;gap:28px;height:68px}
.lp-top nav{display:flex;gap:22px;margin-inline-start:auto;font:500 14px/1 var(--f-ar)}
.lp-top nav a{text-decoration:none;color:var(--muted);transition:color var(--ease)}
.lp-top nav a:hover{color:var(--text)}

.lp-hero{display:grid;grid-template-columns:1.05fr .95fr;gap:56px;align-items:center;padding-block:72px 88px}
.lp-eyebrow{font:500 14px/1.4 var(--f-ar);color:var(--accent);margin:0 0 18px}
.lp-hero h1{font:700 clamp(34px,5vw,56px)/1.18 var(--f-display);letter-spacing:-.01em;margin:0 0 20px;text-wrap:balance}
.lp-lead{font-size:18px;line-height:1.8;color:var(--muted);margin:0 0 32px;max-width:34em}
.lp-cta{display:flex;gap:10px;flex-wrap:wrap}
.lp-cta .btn{--h:50px;padding:0 28px;font-size:16px}

/* Hero: the decision card itself, built in HTML so it reads as the product */
.lp-board{position:relative;padding:22px;border-radius:var(--r);background:var(--surface);box-shadow:var(--shadow-lg)}
.lp-board-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:16px;font:500 13px/1 var(--f-ar);color:var(--muted)}
.lp-stop{display:inline-flex;align-items:center;gap:6px;height:28px;padding:0 12px;border-radius:999px;background:color-mix(in srgb,var(--pulse) 12%,transparent);color:var(--ink);font:500 12px/1 var(--f-ar)}
.lp-stop::before{content:"";width:7px;height:7px;border-radius:50%;background:var(--pulse)}
.lp-sug{border:1px solid var(--line);border-radius:var(--r-sm);padding:18px}
.lp-sug + .lp-sug{margin-top:10px}
.lp-sug-k{font:500 12px/1 var(--f-ar);color:var(--accent);margin:0 0 8px}
.lp-sug h3{font:700 16px/1.5 var(--f-ar);margin:0 0 12px}
.lp-stats{display:grid;grid-template-columns:repeat(3,1fr);gap:8px;margin:0 0 14px}
.lp-stats div{background:var(--bg);border-radius:10px;padding:10px 12px}
.lp-stats dt{font:400 12px/1.3 var(--f-ar);color:var(--muted)}
.lp-stats dd{margin:4px 0 0;font:500 17px/1 var(--f-num);font-variant-numeric:tabular-nums}
.lp-check{display:flex;align-items:center;gap:8px;font:400 13px/1.5 var(--f-ar);color:var(--muted);margin:0 0 14px}
.lp-check svg{color:var(--accent)}
.lp-acts{display:flex;gap:6px}
.lp-acts .btn{--h:36px;padding:0 16px;font-size:14px;pointer-events:none}
.lp-sug.dim{opacity:.55}
.lp-sug.dim h3{margin:0}

.lp-logos{border-block:1px solid var(--line);padding:26px 0}
.lp-logos .lp-wrap{display:flex;align-items:center;gap:32px;flex-wrap:wrap}
.lp-logos p{margin:0;font:500 13px/1 var(--f-ar);color:var(--muted)}
.lp-logos ul{list-style:none;margin:0;padding:0;display:flex;flex-wrap:wrap;gap:26px;align-items:center}
.lp-logo{display:block;width:24px;height:24px;background:var(--ink);opacity:.6;-webkit-mask:var(--src) center/contain no-repeat;mask:var(--src) center/contain no-repeat}

.lp-sec{padding:104px 0}
.lp-sec > .lp-wrap > header{max-width:40em;margin-bottom:52px}
.lp-sec h2{font:700 clamp(28px,3.6vw,40px)/1.25 var(--f-display);margin:0 0 14px;text-wrap:balance}
.lp-sec header p{font-size:17px;line-height:1.8;color:var(--muted);margin:0}

.lp-loop{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(5,1fr);gap:0;counter-reset:s}
.lp-loop li{counter-increment:s;padding-inline:20px;border-inline-start:1px solid var(--line)}
.lp-loop li:first-child{border-inline-start:0;padding-inline-start:0}
.lp-loop li::before{content:counter(s,arabic-indic);display:block;font:900 44px/1 var(--f-display);color:var(--soft);margin-bottom:18px}
.lp-loop h3{font:700 18px/1.4 var(--f-ar);margin:0 0 8px}
.lp-loop p{margin:0;font-size:15px;line-height:1.75;color:var(--muted)}
.lp-loop li:nth-child(4)::before{color:var(--accent)}

.lp-agents{display:grid;grid-template-columns:1fr 2fr;gap:56px}
.lp-group h3{font:500 13px/1 var(--f-ar);color:var(--accent);margin:0 0 6px;letter-spacing:.02em}
.lp-group dl{margin:0;display:grid}
.lp-group.wide dl{grid-template-columns:1fr 1fr;column-gap:40px}
.lp-group dl div{padding:18px 0;border-bottom:1px solid var(--line)}
.lp-group dt{font:700 17px/1.4 var(--f-ar);margin:0 0 4px}
.lp-group dd{margin:0;font-size:15px;line-height:1.7;color:var(--muted)}

.lp-dark{background:var(--deep);color:#FFFFFF}
.lp-dark h2,.lp-dark h3{color:#FFFFFF}
.lp-dark header p{color:color-mix(in srgb,#FFFFFF 72%,transparent)}
.lp-rules{list-style:none;margin:0;padding:0;display:grid;grid-template-columns:repeat(4,1fr);gap:40px}
.lp-rules h3{font:700 19px/1.4 var(--f-ar);margin:0 0 10px;padding-top:18px;border-top:2px solid var(--soft)}
.lp-rules p{margin:0;font-size:15px;line-height:1.75;color:color-mix(in srgb,#FFFFFF 72%,transparent)}

.lp-end{text-align:center}
.lp-end header{margin-inline:auto}
.lp-end .lp-cta{justify-content:center}
.lp-foot{border-top:1px solid var(--line);padding:28px 0;font-size:13px;color:var(--muted)}
.lp-foot .lp-wrap{display:flex;justify-content:space-between;align-items:center;gap:16px}
.lp-foot .mark{font-size:22px}

@media (max-width:960px){
  .lp-hero{grid-template-columns:1fr;gap:44px;padding-block:44px 64px}
  .lp-loop{grid-template-columns:1fr;gap:28px}
  .lp-loop li,.lp-loop li:first-child{border:0;padding:0;display:grid;grid-template-columns:52px 1fr;column-gap:12px}
  .lp-loop li::before{grid-row:span 2;font-size:36px;margin:0}
  .lp-agents{grid-template-columns:1fr;gap:36px}
  .lp-rules{grid-template-columns:1fr 1fr;gap:32px}
}
@media (max-width:640px){
  .lp-top nav{display:none}
  .lp-top .btn{margin-inline-start:auto}
  .lp-top #lang{margin-inline-start:auto}
  .lp-top #lang + .btn{margin-inline-start:0}
  .lp-sec{padding:72px 0}
  .lp-group.wide dl{grid-template-columns:1fr}
  .lp-rules{grid-template-columns:1fr}
  .lp-board{padding:16px}
  .lp-stats dd{font-size:15px}
  .lp-foot .lp-wrap{flex-direction:column}
}
</style>
</head>
<body class="lp">

<header class="lp-top">
  <div class="lp-wrap">
    <span class="mark">Apipeline<i>.</i></span>
    <nav aria-label="الأقسام">
      <a href="#how">كيف يشتغل</a>
      <a href="#agents">الإيجنتس</a>
      <a href="#safety">الأمان</a>
    </nav>
    <span id="lang"></span>
    <a class="btn sm primary" href="/login/">دخول</a>
  </div>
</header>

<main>
  <section class="lp-wrap lp-hero">
    <div>
      <p class="lp-eyebrow">لوحة تسويق بإيجنتس، والقرار الأخير لك</p>
      <h1>كل أرقام إعلاناتك في لوحة وحدة، وقرارات جاهزة تنتظر موافقتك.</h1>
      <p class="lp-lead">Apipeline يجمع أرقام منصاتك كل ساعة، ويقترح وش توقف ووش ترفع، ويفحص المراجع كل اقتراح على قواعدك قبل ما يوصلك. توافق، ويتنفّذ بأمان.</p>
      <div class="lp-cta">
        <a class="btn primary" href="/login/">ادخل للوحة</a>
        <a class="btn secondary" href="#how">شوف كيف يشتغل</a>
      </div>
    </div>

    <div class="lp-board" aria-label="مثال من لوحة القرارات" role="img">
      <div class="lp-board-head"><span>لوحة القرارات · اليوم</span><span class="lp-stop">زر الطوارئ</span></div>
      <article class="lp-sug">
        <p class="lp-sug-k">اقتراح · Meta</p>
        <h3>إيقاف إعلان يصرف ٣ أيام بدون ولا ليد</h3>
        <dl class="lp-stats">
          <div><dt>الصرف</dt><dd>٨٤٠ ريال</dd></div>
          <div><dt>الليدز</dt><dd>٠</dd></div>
          <div><dt>نسبة النقر</dt><dd>٠٫٤٪</dd></div>
        </dl>
        <p class="lp-check"><svg class="i" viewBox="0 0 24 24" aria-hidden="true"><path d="M20 6 9 17l-5-5"/></svg>المراجع: مطابق لقواعدك، وداخل حملة تجربة</p>
        <div class="lp-acts">
          <span class="btn primary">موافقة</span>
          <span class="btn secondary">تعديل</span>
          <span class="btn ghost">رفض</span>
        </div>
      </article>
      <article class="lp-sug dim">
        <p class="lp-sug-k">اقتراح · Snapchat</p>
        <h3>رفع ميزانية مجموعة تكلفتها تحت الهدف بـ ٣٢٪</h3>
      </article>
    </div>
  </section>

  <section class="lp-logos" aria-label="المنصات">
    <div class="lp-wrap">
      <p>يقرا من منصاتك</p>
      <ul>
        {LOGOS.map(l => <li><span class="lp-logo" style={`--src:url(/assets/logos/${l}.svg)`} role="img" aria-label={l}></span></li>)}
      </ul>
    </div>
  </section>

  <section class="lp-sec" id="how">
    <div class="lp-wrap">
      <header>
        <h2>دورة وحدة تمشي كل ساعة</h2>
        <p>من الرقم للقرار للدرس، وأنت في النص. كل خطوة مسجلة وتقدر ترجع عنها.</p>
      </header>
      <ol class="lp-loop">
        {LOOP.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ol>
    </div>
  </section>

  <section class="lp-sec" id="agents" style="padding-top:0">
    <div class="lp-wrap">
      <header>
        <h2>تسع تابات، كل وحدة إيجنت بشغلة واضحة</h2>
        <p>كلها تصب في لوحة القرارات نفسها، والمدير يديرها.</p>
      </header>
      <div class="lp-agents">
        {GROUPS.map((g, i) => (
          <div class:list={['lp-group', { wide: i === 1 }]}>
            <h3>{g.title}</h3>
            <dl>{g.items.map(([n, d]) => <div><dt>{n}</dt><dd>{d}</dd></div>)}</dl>
          </div>
        ))}
      </div>
    </div>
  </section>

  <section class="lp-sec lp-dark" id="safety">
    <div class="lp-wrap">
      <header>
        <h2>قواعد ما تنكسر</h2>
        <p>النظام يقترح وينفّذ، بس داخل حدود أنت ترسمها.</p>
      </header>
      <ul class="lp-rules">
        {RULES.map(([t, d]) => <li><h3>{t}</h3><p>{d}</p></li>)}
      </ul>
    </div>
  </section>

  <section class="lp-sec lp-end">
    <div class="lp-wrap">
      <header>
        <h2>اربط حساباتك وخل الأرقام تتكلم</h2>
        <p>كل ربط بتسجيل دخول المنصة نفسها. بدون ملفات تصدير، وبدون لصق مفاتيح.</p>
      </header>
      <div class="lp-cta">
        <a class="btn primary" href="/login/">ادخل للوحة</a>
      </div>
    </div>
  </section>
</main>

<footer class="lp-foot">
  <div class="lp-wrap">
    <span class="mark">Apipeline<i>.</i></span>
    <span>© Apipeline</span>
  </div>
</footer>

<script is:inline type="module" src="/assets/welcome.js"></script>
</body>
</html>
