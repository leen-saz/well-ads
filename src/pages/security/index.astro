---
// Public landing page for Apipeline Security: code, website, API and mobile app audits. Open without login (src/lib/gate.ts).
// Copy rules (.claude/skills/apipeline-saudi-voice): we promise a process, never "100% secure"; frameworks are named
// as what findings are mapped to, not as certifications we hold; the terminal is labelled as an illustration.
import SiteHeader from '../../components/site/SiteHeader.astro';
import SiteFooter from '../../components/site/SiteFooter.astro';
import { wa } from '../../lib/public-site';

const ar = (n: number) => n.toLocaleString('ar-SA');
const ASK = wa('السلام عليكم، أبي أطلب فحص أمني من Apipeline');

const SCOPE = [
  ['مراجعة الكود', 'نقرا الكود سطر سطر مع أدوات الفحص الثابت، ونركز على المنطق اللي الأدوات ما تشوفه.', ['المصادقة والصلاحيات', 'مفاتيح وأسرار منسية في الكود وتاريخ Git', 'المكتبات القديمة وتراخيصها', 'حقن الأوامر والاستعلامات'], 'M8 6l-6 6 6 6 M16 6l6 6-6 6'],
  ['المواقع والـ API', 'اختبار اختراق للموقع والـ API مثل ما يجربه المهاجم، بإذن مكتوب منك.', ['OWASP Top 10 وAPI Top 10', 'الجلسات وتسجيل الدخول', 'منطق العمل: الدفع والخصومات والطلبات', 'رفع الملفات والحقن'], 'M3 12a9 9 0 1 0 18 0 9 9 0 0 0-18 0Z M3 12h18 M12 3a14 14 0 0 1 0 18 M12 3a14 14 0 0 0 0 18'],
  ['تطبيقات الجوال', 'نفحص تطبيق iOS وAndroid من الملف نفسه إلى الطلبات اللي يرسلها.', ['التخزين المحلي والبيانات الحساسة', 'تثبيت الشهادات والاتصال', 'الهندسة العكسية والتلاعب', 'معايير OWASP MASVS'], 'M7 2h10v20H7z M11 18h2'],
  ['السحابة والإعدادات', 'أغلب التسريبات تجي من إعداد غلط، مو من كود.', ['قواعد البيانات والملفات المكشوفة', 'رؤوس الأمان وTLS وDNS', 'صلاحيات الحسابات والمفاتيح', 'Cloudflare وAWS وSupabase وVercel'], 'M7 18a5 5 0 1 1 1-9.9A6 6 0 0 1 19 10a4 4 0 0 1-1 8Z'],
  ['الفحص المستمر', 'نركّب فحوصات تشتغل مع كل تحديث في GitHub، عشان الثغرة ما ترجع.', ['فحص الأسرار قبل الدمج', 'تنبيهات المكتبات المعرّضة', 'فحص الكود في كل Pull Request', 'تقرير شهري مختصر'], 'M4 12a8 8 0 0 1 14-5.3L20 9 M20 4v5h-5 M20 12a8 8 0 0 1-14 5.3L4 15 M4 20v-5h5'],
  ['الامتثال', 'نربط كل نتيجة بالضابط اللي يخصها، عشان تعرف وش ينطبق عليك.', ['ضوابط الهيئة الوطنية للأمن السيبراني (ECC)', 'نظام حماية البيانات الشخصية (PDPL)', 'متطلبات بوابات الدفع', 'خطة إصلاح مرتبة حسب الأولوية'], 'M9 12l2 2 4-4 M12 3l8 3v6c0 5-3.5 8-8 9-4.5-1-8-4-8-9V6z'],
];

const STEPS = [
  ['النطاق', 'نتفق على وش ينفحص', 'نحدد الأنظمة والبيئة والمدة وطرق التواصل، وتوقّع إذن الفحص المكتوب قبل أي خطوة.'],
  ['الفحص الآلي', 'نمسح السطح كامل', 'أدوات فحص للكود والمكتبات والموقع والإعدادات، تطلع لنا الخريطة الأولى.'],
  ['التحقق اليدوي', 'نتأكد من كل نتيجة', 'نجرب كل ثغرة بأيدينا، ونشيل الإنذارات الكاذبة، وندور على اللي الأدوات ما تلقاه.'],
  ['التقرير', 'كل ثغرة بدليلها', 'خطوات إعادة الإنتاج، ودرجة الخطورة، والأثر، وطريقة الإصلاح. ونسخة مختصرة للإدارة.'],
  ['إعادة الفحص', 'نتأكد إنها انقفلت', 'بعد ما يصلح فريقك، نعيد الفحص على كل ثغرة ونسلّمك خطاب بالنتيجة.'],
];

const SEV = [
  ['s1', 'حرجة', 'وصول مباشر للبيانات أو للنظام. تنصلح فورًا.'],
  ['s2', 'عالية', 'ثغرة تنستغل بجهد معقول. خلال أيام.'],
  ['s3', 'متوسطة', 'تحتاج ظرف معيّن أو تُضعف حماية ثانية.'],
  ['s4', 'منخفضة', 'تحسينات وإعدادات. ضمن خطة الصيانة.'],
];

const PRINCIPLES = [
  ['بإذن مكتوب بس', 'ما نلمس أي نظام قبل ما يكون عندنا إذن موقّع ونطاق واضح.', 'M14 3H6v18h12V7z M14 3v4h4 M9 13h6 M9 17h4'],
  ['بياناتك ما تطلع', 'أي بيانات نشوفها أثناء الفحص ما تنحفظ ولا تنسخ، والتقرير يوصلك بقناة مشفّرة.', 'M5 11h14v10H5z M8 11V7a4 4 0 0 1 8 0v4'],
  ['بدون تخويف', 'نرتب الثغرات حسب أثرها الفعلي عليك، مو حسب عددها.', 'M12 9v4 M12 17h0 M10.3 3.9 2 18a2 2 0 0 0 1.7 3h16.6a2 2 0 0 0 1.7-3L13.7 3.9a2 2 0 0 0-3.4 0Z'],
  ['نشرح لفريقك', 'نجلس مع المطورين ونمشي على كل إصلاح، عشان ما تتكرر.', 'M17 21v-2a4 4 0 0 0-4-4H5a4 4 0 0 0-4 4v2 M9 7a4 4 0 1 0 0 8 M23 21v-2a4 4 0 0 0-3-3.9 M16 3.1a4 4 0 0 1 0 7.8'],
];

const FAQ = [
  ['هل الفحص يأثر على موقعي وهو شغال؟', 'نتفق مسبقًا على أوقات الفحص وحدوده، ونفضّل بيئة تجريبية مطابقة إذا متوفرة. الاختبارات اللي ممكن تضغط على النظام ما نسويها إلا بموافقتك.'],
  ['كم ياخذ الفحص؟', 'يعتمد على حجم النطاق: موقع واحد يختلف عن منصة كاملة مع تطبيقين. نحدد المدة في عرض السعر قبل ما نبدأ.'],
  ['هل تعطوني شهادة؟', 'نسلّمك تقرير مفصّل وخطاب إعادة فحص يوضح حالة كل ثغرة. ما نصدر شهادات اعتماد رسمية، ونوضح لك وش تحتاج لو كان عندك متطلب تنظيمي.'],
  ['هل تصلحون الثغرات بنفسكم؟', 'نعطي فريقك خطوات الإصلاح ونراجعها معهم، ونقدر نساعد في التنفيذ إذا طلبت ذلك ضمن اتفاق منفصل.'],
  ['وش تحتاجون مني؟', 'إذن فحص مكتوب، وتحديد النطاق، وحساب تجريبي أو بيئة اختبار، وشخص من فريقك نتواصل معه وقت الفحص.'],
];
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#1D1069">
<title>Apipeline · الأمن السيبراني</title>
<meta name="description" content="فحص أمني للأكواد والمواقع والـ API وتطبيقات الجوال، مع تقرير مرتب حسب الخطورة وإعادة فحص بعد الإصلاح.">
<link rel="preload" href="/assets/fonts/thmanyahserifdisplay-Black.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<link rel="stylesheet" href="/assets/site.css">
</head>
<body class="st">

<SiteHeader current="/security/" cta={{ href: ASK, label: 'اطلب فحص' }} />

<main>
  <section class="st-wrap st-hero">
    <div>
      <p class="st-eyebrow">فحص أمني للأكواد والمواقع والتطبيقات</p>
      <h1 class="st-h1">نلقى الثغرة <em>قبل لا يلقاها غيرك.</em></h1>
      <p class="st-lead">نفحص الكود والموقع والتطبيق مثل ما يفحصه المهاجم، ونسلّمك كل ثغرة بدليلها ودرجة خطورتها وطريقة إصلاحها. وبعد ما تصلح، نعيد الفحص.</p>
      <div class="st-cta">
        <a class="btn primary" href={ASK} rel="noopener" target="_blank">اطلب فحص</a>
        <a class="btn secondary" href="#scope">وش نفحص</a>
      </div>
      <p class="st-note">ما نبدأ أي فحص بدون إذن مكتوب منك.</p>
    </div>
    <div>
      <div class="st-term" role="img" aria-label="مثال توضيحي لنتائج فحص" data-depth="0.06">
        <div class="dots"><i></i><i></i><i></i></div>
        <div data-type>
          <p><span class="c">$</span> apipeline audit --scope web,api,android,ios</p>
          <p class="c">› mapping attack surface… 38 endpoints</p>
          <p><span class="crit">[critical]</span> SQL injection · GET /api/orders?id=</p>
          <p><span class="hi">[high]</span> Hardcoded secret · src/config.ts:12</p>
          <p><span class="hi">[high]</span> IDOR · GET /api/invoices/:id</p>
          <p>[medium] No rate limit · POST /login</p>
          <p class="c">[low] Verbose server header</p>
          <p class="c">› report ready · 5 findings · retest booked</p>
          <p class="ok">✓ retest: 5/5 closed</p>
        </div>
      </div>
      <p class="st-note" style="text-align:center">مثال توضيحي، مو نتائج عميل.</p>
    </div>
  </section>

  <section class="st-words-sec">
    <div class="st-wrap">
      <p class="st-words" data-words>أغلب الاختراقات ما تبدأ بهجوم ذكي. تبدأ بمفتاح منسي في الكود، أو صفحة دخول بدون حد للمحاولات، أو مكتبة ما تحدّثت من سنتين. نلقاها، ونقفلها معك.</p>
    </div>
  </section>

  <section class="st-sec" id="scope" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">وش نفحص</span>
        <h2>من أول سطر كود إلى آخر إعداد في السحابة</h2>
        <p>تختار النطاق اللي يناسبك، أو نبدأ بمراجعة سريعة ونحدد معك الأولويات.</p>
      </header>
      <div class="st-grid">
        {SCOPE.map(([t, d, list, p]) => (
          <article class="st-tile" data-reveal>
            <span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={p as string}/></svg></span>
            <h3>{t}</h3><p>{d}</p>
            <ul>{(list as string[]).map(x => <li>{x}</li>)}</ul>
          </article>
        ))}
      </div>
    </div>
  </section>

  <section class="st-sec" id="how" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">كيف نشتغل</span>
        <h2>خمس خطوات، وكل وحدة لها مخرج</h2>
      </header>
      <div class="st-steps" data-steps>
        <div class="st-steps-visual" data-steps-visual aria-hidden="true">
          <div class="st-panel"><span class="big">النطاق</span><ul><li>الأنظمة<b>٣</b></li><li>البيئة<b>تجريبية</b></li><li>إذن الفحص<b>✓ موقّع</b></li></ul></div>
          <div class="st-panel"><span class="big" data-count="38">٣٨</span><p style="margin:0;color:var(--muted)">نقطة دخول انرصدت في الخريطة الأولى</p></div>
          <div class="st-panel"><ul><li>نتائج الأدوات<b>٢١</b></li><li>إنذارات كاذبة<b>١٦−</b></li><li>ثغرات مؤكدة<b>٥</b></li></ul><span class="st-chip">تحقق يدوي</span></div>
          <div class="st-panel"><span class="st-chip hot">حرجة · SQL injection</span><ul><li>خطوات إعادة الإنتاج<b>✓</b></li><li>الأثر<b>✓</b></li><li>طريقة الإصلاح<b>✓</b></li></ul></div>
          <div class="st-panel"><span class="big">٥ من ٥</span><p style="margin:0;color:var(--muted)">ثغرات انقفلت بعد إعادة الفحص</p><span class="st-chip ok">خطاب إعادة الفحص</span></div>
        </div>
        <div class="st-steps-list">
          <span class="st-steps-line" data-steps-line aria-hidden="true"></span>
          <ol style="list-style:none;margin:0;padding:0">
            {STEPS.map(([n, h, p], i) => <li class="st-step" data-step><p class="n">{`${ar(0)}${ar(i + 1)} · ${n}`}</p><h3>{h}</h3><p>{p}</p></li>)}
          </ol>
        </div>
      </div>
      <p class="st-note">الأرقام في اللوحة مثال توضيحي.</p>
    </div>
  </section>

  <section class="st-sec" style="padding-top:0">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">التقرير</span>
        <h2>نرتب الثغرات حسب أثرها، مو حسب عددها</h2>
        <p>كل ثغرة لها درجة خطورة واضحة ومدة إصلاح مقترحة، عشان فريقك يعرف من وين يبدأ.</p>
      </header>
      <div class="st-sev">
        {SEV.map(([c, t, d]) => <div class={c} data-reveal><b>{t}</b><span>{d}</span></div>)}
      </div>
    </div>
  </section>

  <section class="st-sec st-dark">
    <div class="st-wrap">
      <header class="st-head" data-reveal>
        <span class="kick">مبادئنا</span>
        <h2>نفحص مثل المهاجم، ونتصرف مثل الشريك</h2>
      </header>
      <div class="st-grid four">
        {PRINCIPLES.map(([t, d, p]) => <article class="st-tile" data-reveal><span class="ic"><svg viewBox="0 0 24 24" aria-hidden="true"><path d={p}/></svg></span><h3>{t}</h3><p>{d}</p></article>)}
      </div>
    </div>
  </section>

  <section class="st-sec">
    <div class="st-wrap">
      <header class="st-head" data-reveal><span class="kick">أسئلة</span><h2>قبل ما نبدأ</h2></header>
      <div class="st-faq">
        {FAQ.map(([q, a]) => <details data-reveal><summary>{q}</summary><p>{a}</p></details>)}
      </div>
    </div>
  </section>

  <section class="st-end" id="contact">
    <div class="st-wrap" data-reveal>
      <h2>قبل ما تطلق التحديث الجاي، خلنا نفحصه</h2>
      <p>أرسل لنا وش عندك: موقع، API، تطبيق، أو كود. نرد عليك بالنطاق المقترح والمدة.</p>
      <div class="st-cta"><a class="btn primary" href={ASK} rel="noopener" target="_blank">اطلب فحص</a><a class="btn secondary" href="/profile/">من نحن</a></div>
    </div>
  </section>
</main>

<SiteFooter />

<script is:inline type="module" src="/assets/welcome.js"></script>
<script>import '../../lib/scroll-story';</script>
</body>
</html>
