---
// Ported as-is from well-ads-dashboard web/public/login/index.html
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>الدخول · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&display=swap">
<link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<main class="auth"><div class="card">
  <div class="bar" style="justify-content:space-between;margin-bottom:28px"><span class="mark" style="margin:0">Well<i>.</i></span><span id="lang"></span></div>
  <h1>أهلاً فيك</h1>
  <p class="muted" style="margin:0">ادخل بإيميل الشركة.</p>
  <form id="f" novalidate>
    <label for="email">الإيميل</label><input type="email" id="email" autocomplete="username" required>
    <label for="password">الباسوورد</label><input type="password" id="password" autocomplete="current-password" required>
    <div class="actions"><button class="btn primary" type="submit">دخول</button><button class="btn ghost" type="button" id="forgot">نسيت الباسوورد</button></div>
    <div class="msg" id="msg" role="status"></div>
  </form>
</div></main>
<script is:inline type="module" src="/assets/login.js"></script>
</body>
</html>
