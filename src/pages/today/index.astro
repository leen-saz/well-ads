---
import { ClientRouter } from 'astro:transitions';
// احلم: صفحة البداية لكل مستخدم حسب صلاحياته: المساعد (public/assets/ahlam.js) وملخص اليوم في تبويب ثاني. وش جاهز، وش ناقص من الإعداد، أهم إجراء اليوم، والأدوات المسموحة له.
// الأرقام من /api/today/state (src/api/routes/today.ts)، والسكربت public/assets/today.js
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>احلم · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>
.td-hello{margin:0 0 18px;max-width:760px}
.td-next{padding:20px 24px;display:flex;gap:16px;align-items:center;flex-wrap:wrap;box-shadow:inset 3px 0 0 var(--accent);margin:0 0 20px}
.td-next div{flex:1 1 260px}.td-next h2{margin:0 0 4px;font-size:18px}.td-next p{margin:0}
.td-grid{display:grid;grid-template-columns:repeat(auto-fit,minmax(280px,1fr));gap:16px;margin:0 0 20px}
.td-grid .card{padding:18px 20px}.td-grid h2{margin:0 0 12px;font-size:16px}
.td-list{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.td-list li{display:flex;gap:8px;align-items:flex-start;font-size:14px}.td-list .i{flex:none;margin-top:2px}
.td-ok .i{color:#14532D}.td-miss .i{color:#7A4B00}
.td-kpis{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:12px 16px}
.td-kpis b{display:block;font-size:20px}.td-kpis small{color:var(--muted);font-size:12px}
.td-tools h2{margin:0 0 6px;font-size:16px}
.td-tools .td-sec{margin:0 0 16px}.td-tools .td-sec h3{margin:0 0 8px;font-size:13px;color:var(--muted);font-weight:500}
.td-links{display:flex;flex-wrap:wrap;gap:8px}
.td-links a{display:inline-flex;align-items:center;gap:8px;min-height:40px;padding:0 14px;border-radius:999px;border:1px solid var(--line);color:inherit;text-decoration:none;font-size:14px}
.td-links a:hover{background:var(--tint)}.td-links a:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.td-tabs{margin:0 0 16px}
.ah{display:grid;gap:14px;max-width:860px}
.ah-card{padding:18px 20px;display:grid;gap:14px}
.ah-note{margin:0;font-size:13px}
.cm-head{display:flex;gap:12px;align-items:center;justify-content:space-between;flex-wrap:wrap}
.cm-list{list-style:none;margin:0;padding:0;display:grid;gap:8px}
.cm-list button{width:100%;display:flex;justify-content:space-between;gap:12px;flex-wrap:wrap;text-align:start;padding:12px 14px;border:1px solid var(--line);border-radius:12px;background:transparent;color:inherit;font:inherit;cursor:pointer}
.cm-list button:hover{background:var(--tint)}.cm-h{margin:0;font-size:20px}
.cm-form{display:grid;gap:12px}.cm-f{display:grid;gap:4px;border:0;padding:0;margin:0}.cm-f>span,.cm-f>legend{font-size:13px;color:var(--muted)}
.cm-f textarea,.cm-f select{padding:10px 12px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:inherit;font:inherit;font-size:15px}
.cm-c{display:inline-flex;gap:6px;align-items:center;margin-inline-end:14px;font-size:14px}
.cm-out{margin:8px 0;padding:10px 12px;border:1px solid var(--line);border-radius:10px}.cm-text{font-size:14px;line-height:1.7}.cm-kpis{margin:6px 0 0;padding-inline-start:18px}.cm-hits{margin:6px 0 0;padding-inline-start:18px;font-size:13px}.cm-hits .critical{color:var(--err,#b3261e)}.cm-hits .warn{color:var(--warn,#8a5a00)}.cm-ok{color:var(--muted)}
.cm-prog{padding:12px 14px;border-radius:12px;background:var(--tint);display:grid;gap:6px}.cm-bar{height:8px;border-radius:99px;background:var(--line);overflow:hidden}.cm-bar i{display:block;height:100%;background:var(--accent);transition:width .4s}.cm-dots{display:inline-flex;gap:5px;margin-inline-start:8px}.cm-dot{display:inline-block;width:9px;height:9px;border-radius:50%;background:var(--muted);vertical-align:middle}.cm-dot.run{background:var(--accent);animation:ahp 1s infinite ease-in-out}.cm-dot.wait{background:var(--accent);opacity:.55}.cm-dot.ok{background:var(--ok,#1a7f4b)}.cm-dot.off{background:#9aa0a6}.cm-dot.bad{background:var(--err,#b3261e)}@media (prefers-reduced-motion:reduce){.cm-dot.run{animation:none}}.cm-st[data-s=running]{color:var(--accent);font-weight:600}
.cm-ovr{margin:6px 0;padding:6px 10px;border-radius:8px;background:var(--tint);font-size:13px}.cm-ovf{display:grid;gap:8px;margin-top:8px;padding:10px 12px;border:1px dashed var(--line);border-radius:10px}
.cm-qs{list-style:none;margin:0;padding:0;display:grid;gap:12px}.cm-qs li{display:grid;gap:6px}.cm-qs textarea{padding:8px 10px;border-radius:10px;border:1px solid var(--line);background:var(--surface);color:inherit;font:inherit}.cm-asm{font-size:12px;padding:1px 8px;border-radius:999px;background:var(--tint-2,var(--tint));color:var(--muted)}.cm-asm.ans{background:var(--accent);color:#fff}
.cm-actions{display:flex;gap:8px;flex-wrap:wrap}.cm-tasks{display:grid;gap:10px;padding-inline-start:20px}.cm-cost{padding:12px 14px;border-radius:12px;background:var(--tint)}
.ah-chips{display:flex;flex-wrap:wrap;gap:8px}
.ah-chips button{min-height:36px;padding:0 14px;border-radius:999px;border:1px solid var(--line);background:transparent;color:inherit;font:inherit;font-size:14px;cursor:pointer}
.ah-chips button:hover{background:var(--tint)}.ah-chips button:focus-visible{outline:2px solid var(--accent);outline-offset:2px}
.ah-log{display:grid;gap:12px;max-height:56vh;overflow-y:auto;padding:2px}
.ah-m{padding:12px 14px;border-radius:14px;font-size:15px;line-height:1.7;max-width:92%;overflow-wrap:anywhere}
.ah-m.me{background:var(--tint);justify-self:start}.ah-m.bot{background:var(--surface);box-shadow:inset 0 0 0 1px var(--line);justify-self:stretch;max-width:100%}
.ah-m p{margin:0 0 8px}.ah-m p:last-child{margin:0}.ah-m ul{margin:0 0 8px;padding-inline-start:20px}
.ah-src{display:flex;flex-wrap:wrap;gap:6px;align-items:center;margin-top:10px;font-size:12px;color:var(--muted)}
.ah-src span.p{padding:2px 10px;border-radius:999px;border:1px solid var(--line)}
.ah-think{display:flex;gap:12px;align-items:flex-start;color:var(--muted);font-size:14px}.ah-think ul{list-style:none;margin:0;padding:0;display:grid;gap:2px}.ah-think li.now{color:inherit}.ah-think li.done::before{content:'✓ ';opacity:.6}
.ah-dots{display:inline-flex;gap:4px;padding-top:9px}.ah-dots i{width:7px;height:7px;border-radius:50%;background:var(--accent);animation:ahp 1s infinite ease-in-out}.ah-dots i:nth-child(2){animation-delay:.15s}.ah-dots i:nth-child(3){animation-delay:.3s}
@keyframes ahp{0%,80%,100%{opacity:.25;transform:scale(.8)}40%{opacity:1;transform:scale(1)}}@media (prefers-reduced-motion:reduce){.ah-dots i{animation:none;opacity:.7}}
.ah-form{display:flex;gap:8px;align-items:flex-end}
.ah-form textarea{flex:1;min-height:46px;max-height:140px;resize:vertical;padding:10px 12px;border-radius:12px;border:1px solid var(--line);background:var(--surface);color:inherit;font:inherit;font-size:15px}
.ah-form textarea:focus-visible{outline:2px solid var(--accent);outline-offset:1px}
@media (max-width:560px){.ah-form{flex-direction:column;align-items:stretch}.ah-m{max-width:100%}}
</style>
</head>
<body data-page="today">
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <p class="muted td-hello" id="hello"></p>
      <div class="seg td-tabs" id="tdTabs" role="group"></div>
      <section id="paneAhlam" class="ah"></section>
      <section id="paneCamp" class="ah" hidden></section>
      <div id="paneSum" hidden>
      <section class="card td-next" id="next" aria-live="polite"><div><h2>يحمّل…</h2></div></section>
      <div class="td-grid">
        <section class="card" aria-labelledby="perfH"><h2 id="perfH">ملخص الأداء</h2><div id="perf" class="muted">يحمّل…</div></section>
        <section class="card" aria-labelledby="readyH"><h2 id="readyH">وش جاهز</h2><ul class="td-list" id="ready"></ul></section>
        <section class="card" aria-labelledby="missH"><h2 id="missH">وش ناقص من الإعداد</h2><ul class="td-list" id="miss"></ul></section>
      </div>
      <section class="card pad td-tools" aria-labelledby="toolsH"><h2 id="toolsH">أدواتك</h2><p class="muted" style="margin:0 0 14px">اللي تسمح فيه صلاحياتك.</p><div id="mytools"></div></section>
      </div>
      <div class="msg" id="msg" role="status"></div>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
