---
// Ported as-is from well-ads-dashboard web/public/account/index.html
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>حسابي · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&display=swap">
<link rel="stylesheet" href="/assets/app.css">
</head>
<body>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <section class="card pad" style="max-width:520px">
        <h2>تغيير الباسوورد</h2>
        <p class="muted" id="who" style="margin:0"></p>
        <form id="f" novalidate>
          <label for="cur">الباسوورد الحالي</label><input type="password" id="cur" autocomplete="current-password" required>
          <label for="p1">الباسوورد الجديد</label><input type="password" id="p1" autocomplete="new-password" required>
          <label for="p2">أعد كتابته</label><input type="password" id="p2" autocomplete="new-password" required>
          <div class="bar" style="margin-top:20px"><button class="btn primary" type="submit">احفظ</button></div>
          <div class="msg" id="msg" role="status"></div>
        </form>
      </section>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/account.js"></script>
</body>
</html>
