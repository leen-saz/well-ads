---
import { ClientRouter } from 'astro:transitions';
// المكتبة: ما تحفظه من أي تاب، بفلتر وبحث ونجمة للمفضلة (docs/library.md). السكربت في public/modules/library/client.js
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>المكتبة · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="preload" href="/assets/fonts/playfair-display-900.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="/assets/app.css">
<ClientRouter />
<style is:global>
.lb-filters{display:flex;gap:8px;flex-wrap:wrap;align-items:end;margin:0 0 14px}
.lb-filters > div{display:grid;gap:4px;min-width:140px}
.lb-filters label{font-size:12px;color:var(--muted)}
.lb-filters select,.lb-filters input{margin:0;height:38px}
.lb-list{display:grid;gap:12px}
.lb-item{padding:14px 16px;display:grid;gap:8px}
.lb-top{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.lb-top h3{margin:0;font-size:16px}
.lb-chip{font-size:12px;padding:2px 10px;border-radius:999px;background:var(--tint)}
.lb-chip.ok{background:color-mix(in srgb,var(--accent) 16%,transparent)}
.lb-star{all:unset;cursor:pointer;margin-inline-start:auto;width:36px;height:36px;display:grid;place-items:center;border-radius:999px;font-size:20px;line-height:1;color:var(--muted)}
.lb-star:hover,.lb-star:focus-visible{background:var(--tint)}
.lb-star[aria-pressed="true"]{color:var(--accent)}
.lb-body{white-space:pre-wrap;margin:0;font-size:15px;line-height:1.8}
.lb-flag{font-size:13px;padding:8px 12px;border-radius:12px;background:var(--tint)}
.lb-flag.bad{background:color-mix(in srgb,var(--pulse) 12%,transparent)}
.lb-act{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.lb-edit{display:grid;gap:8px}
.lb-empty{padding:28px 16px;text-align:center}
</style>
</head>
<body data-page="library" data-module>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة" transition:persist="side"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <p class="muted" style="margin:0 0 14px">كل ما تحفظه من التابات يجي هنا مع نتيجة فحص الامتثال. حط نجمة على اللي تبي ترجع له بسرعة.</p>
      <form class="lb-filters" id="filters" novalidate>
        <div><label for="fq">بحث</label><input type="search" id="fq" placeholder="كلمة من العنوان أو النص"></div>
        <div><label for="fmod">التاب</label><select id="fmod"><option value="">الكل</option></select></div>
        <div><label for="fkind">النوع</label><select id="fkind"><option value="">الكل</option></select></div>
        <div><label for="fplat">المنصة</label><input type="text" id="fplat" placeholder="مثلاً meta"></div>
        <div><label for="fserv">الخدمة</label><input type="text" id="fserv"></div>
        <div><label for="fstar">المفضلة</label><select id="fstar"><option value="">الكل</option><option value="1">المفضلة بس</option></select></div>
      </form>
      <div class="lb-list" id="list" aria-live="polite"></div>
      <div class="msg" id="msg" role="status"></div>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/router.js"></script>
</body>
</html>
