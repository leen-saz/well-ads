---
// السوشال: تقويم المنشورات لكل شركة. النشر يشغّله Cron في الـ Worker (src/lib/social-cron.ts).
---
<!doctype html>
<html lang="ar" dir="rtl">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width,initial-scale=1,viewport-fit=cover">
<meta name="robots" content="noindex,nofollow">
<meta name="referrer" content="no-referrer">
<meta name="theme-color" content="#F6F0E3">
<title>السوشال · Well</title>
<link rel="preload" href="/assets/fonts/thmanyahsans-Regular.woff2" as="font" type="font/woff2" crossorigin>
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Playfair+Display:wght@900&display=swap">
<link rel="stylesheet" href="/assets/app.css">
<style is:global>
.so-grid{display:grid;grid-template-columns:minmax(0,420px) minmax(0,1fr);gap:16px;align-items:start}
@media (max-width:1000px){.so-grid{grid-template-columns:1fr}}
.so-cnt{font-size:12px;margin:4px 0 0}.so-cnt.over{color:#C0392B}
.so-day{margin:18px 0 8px;font-size:15px}
.so-post{padding:14px 16px;display:grid;gap:8px}
.so-top{display:flex;gap:8px;flex-wrap:wrap;align-items:center}
.so-chip{font-size:12px;padding:3px 10px;border-radius:999px;background:var(--tint)}
.so-st{margin-inline-start:auto;font-size:12px}
.so-body{white-space:pre-wrap;margin:0}
.so-note{font-size:13px;margin:8px 0 0;padding:10px 12px;border-radius:12px;background:var(--tint)}
</style>
</head>
<body>
<div class="app" id="app">
  <aside class="side" id="side" aria-label="القائمة"></aside>
  <div class="scrim"></div>
  <div class="main">
    <header class="topbar" id="top"></header>
    <main class="content" id="content">
      <div class="so-grid">
        <section class="card pad">
          <h2>منشور جديد</h2>
          <form id="f" novalidate>
            <label>المنصات</label><div class="checks" id="plats"></div>
            <label for="body">النص</label><textarea id="body" rows="6"></textarea>
            <p class="so-cnt muted" id="cnt"></p>
            <label for="media">رابط صورة أو فيديو <span class="muted">(اختياري، https)</span></label><input type="url" id="media" dir="ltr" placeholder="https://">
            <label for="at">وقت النشر</label><input type="datetime-local" id="at" required>
            <label>طريقة النشر</label>
            <div class="seg" role="group" aria-label="طريقة النشر"><button type="button" data-mode="manual" aria-pressed="true">يدوي (بموافقة)</button><button type="button" data-mode="auto" aria-pressed="false">تلقائي</button></div>
            <p class="so-note" id="modeNote">ينتظر موافقتك قبل ما ينشر.</p>
            <div class="bar" style="margin-top:20px"><button class="btn primary" type="submit">جدوِل</button></div>
            <div class="msg" id="msg" role="status"></div>
            <div id="notices"></div>
          </form>
        </section>
        <section>
          <div class="bar" style="justify-content:space-between"><h2 style="margin:0">التقويم</h2><span class="muted" id="range"></span></div>
          <div id="list"></div>
        </section>
      </div>
    </main>
  </div>
</div>
<script is:inline type="module" src="/assets/social.js"></script>
</body>
</html>
