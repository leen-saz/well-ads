# Secrets of the hourly pipeline (GitHub environment `production` of leen-saz/well-ads). Copy to pipeline.env
# OUTSIDE the repo, fill, then:
#   gh secret set -f pipeline.env --env production -R leen-saz/well-ads
# and delete the file. Keys already saved from the connect tab live in Supabase Vault and win over these,
# so a platform connected there can stay empty here (remove its lines).

SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

META_ACCESS_TOKEN=
META_AD_ACCOUNT_ID=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
GOOGLE_ADS_REFRESH_TOKEN=
GOOGLE_ADS_CUSTOMER_ID=
GOOGLE_ADS_LOGIN_CUSTOMER_ID=
GOOGLE_ADS_DEVELOPER_TOKEN=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
SNAP_REFRESH_TOKEN=
SNAP_AD_ACCOUNT_ID=
SNAP_ORGANIZATION_ID=
GA4_PROPERTY_ID=
# One line: the service account JSON in single quotes, e.g. GA4_SERVICE_ACCOUNT_JSON='{"type":"service_account",...}'
GA4_SERVICE_ACCOUNT_JSON=

# Used by the scheduled workflows of the same `production` environment (not by the hourly pull itself)
# Backups (db-backup, db-restore-test): the encryption passphrase (keep an offline copy: without it no backup opens) and a Cloudflare token
# with R2 write on the private bucket well-ads-backups, plus the account id. refresh.yml uses the same two Cloudflare values for the site bucket.
BACKUP_PASSPHRASE=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_ACCOUNT_ID=
# CRM leads pull (pipeline/crm/fetch.py): the API key the CRM gives for read access
CRM_API_KEY=
# TikTok: keep another company's TikTok account out of the numbers (docs/tiktok-exclusion.md). Both are private: never write the real values in the repo.
# Ids: comma separated advertiser ids. Markers: ';' separated, case-insensitive words found in that company's ad, campaign or account names.
TIKTOK_EXCLUDED_ADVERTISER_IDS=
TIKTOK_EXCLUDED_MARKERS=

