# Secrets of the Cloudflare Worker (the site). Copy to worker.env OUTSIDE the repo, fill, then:
#   npx wrangler secret bulk worker.env --name well-ads
# and delete the file. Lines left empty are skipped by you: remove them before running.

# Supabase (Leen Well account → Well project → Project Settings → API / API Keys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A new random value: run `openssl rand -base64 48` and paste the output
SESSION_SECRET=

# "Connect" button (authentication). Only for platforms you want the button on; each from the platform's developer page
META_APP_ID=
META_APP_SECRET=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MSADS_CLIENT_ID=
MSADS_CLIENT_SECRET=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=

# AI models (src/lib/llm.ts). Each one is optional: without its key that tab stays on the free Workers AI.
# PAID: every call is billed to the account of the key. Workers AI (the current default) is free within Cloudflare's daily limit.
# OpenAI → Content (SEO/AEO), Design, the compliance rewrite and the Knowledge training chat. Key: platform.openai.com → API keys
OPENAI_API_KEY=
# Optional model id; empty = gpt-6.1-sol. Other ids on OpenAI's models page (e.g. gpt-6-astra = strongest, gpt-6-luna = cheapest)
OPENAI_MODEL=
# Design backgrounds (OpenAI Images: «صمّم»; with a product photo it is an edit that keeps the product). PAID per image. Optional; default gpt-image-2.
OPENAI_IMAGE_MODEL=
# xAI (Grok) → Social, Listening (live X search, and TikTok through web search: also billed per post fetched; web search $5 per 1,000 calls).
# PAID. Key: console.x.ai → API keys. Maestro's agents run in Paperclip: their model is set there (docs/paperclip.md).
XAI_API_KEY=
# Optional model id; empty = grok-4.7. Cheaper: grok-4.3
XAI_MODEL=
# Anthropic (Claude) → the Debugger's "اشرح لي وش أسوي" plan. PAID per call. Key: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional model id; empty = claude-opus-5-5
ANTHROPIC_MODEL=
