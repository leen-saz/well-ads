# Secrets of the Cloudflare Worker (the site). Copy to worker.env OUTSIDE the repo, fill, then:
#   npx wrangler secret bulk worker.env --name well-ads
# and delete the file. Lines left empty are skipped by you: remove them before running.

# Supabase (Leen Well account → Well project → Project Settings → API / API Keys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A new random value: run `openssl rand -base64 48` and paste the output
SESSION_SECRET=
# The owner's sign-in email (the only account that is always owner). NOT in the public wrangler.jsonc: it is a secret per environment, and
# `wrangler secret bulk` below sets it for the environment you pass with --env (repeat for staging and production). deploy.yml stops if it is missing.
OWNER_EMAIL=

# "Connect" button (authentication). Only for platforms you want the button on; each from the platform's developer page
META_APP_ID=
META_APP_SECRET=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MSADS_CLIENT_ID=
MSADS_CLIENT_SECRET=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=

# AI models (src/lib/llm.ts). Each one is optional: without its key that tab stays on the free Workers AI.
# PAID: every call is billed to the account of the key. Workers AI (the current default) is free within Cloudflare's daily limit.
# OpenAI → Content (SEO/AEO), Design, the compliance rewrite and the Knowledge training chat. Key: platform.openai.com → API keys
OPENAI_API_KEY=
# Optional model id; empty = gpt-6.1-sol. Other ids on OpenAI's models page (e.g. gpt-6-astra = strongest, gpt-6-luna = cheapest)
OPENAI_MODEL=
# Design backgrounds (OpenAI Images: «صمّم»; with a product photo it is an edit that keeps the product). PAID per image. Optional; default gpt-image-2.
OPENAI_IMAGE_MODEL=
# YouTube Data API v3 → Listening (videos that mention us). FREE daily quota. Google Cloud → APIs → YouTube Data API v3 → Credentials → API key
YOUTUBE_API_KEY=
# Reddit → Listening reuses REDDIT_CLIENT_ID / REDDIT_CLIENT_SECRET above: a free "script" app at reddit.com/prefs/apps
# xAI (Grok) → Social, Listening (live X search, and TikTok through web search: also billed per post fetched; web search $5 per 1,000 calls).
# PAID. Key: console.x.ai → API keys. Maestro's agents run in Paperclip: their model is set there (docs/paperclip.md).
XAI_API_KEY=
# Optional model id; empty = grok-4.7. Cheaper: grok-4.3
XAI_MODEL=
# OpenRouter → any task, only when the owner picks it for that task (Maestro → «موديلات الذكاء الاصطناعي»). PAID by OpenRouter per call, recorded in
# ai_usage with the cost OpenRouter returns. Key: openrouter.ai → Keys. Without it nothing changes: every task stays on its current provider.
OPENROUTER_API_KEY=
# Optional, plain text (not a secret): the site address OpenRouter shows next to the calls, https only
OPENROUTER_SITE_URL=
# Gemini (Google) → Transcribe (audio and video to text), Vision, and Voiceover / Voice (speech). PAID per token; every call is recorded in ai_usage and
# counts against the tab's monthly cap. Key: aistudio.google.com → Get API key. Without it those tabs say they are not fully set up.
GEMINI_API_KEY=
# Optional model ids (Google's model page); empty = gemini-3-flash for text, audio, video and images, and gemini-3.1-flash-tts-preview for speech
GEMINI_MODEL=
GEMINI_TTS_MODEL=
# Anthropic (Claude) → the Debugger's "اشرح لي وش أسوي" plan. PAID per call. Key: console.anthropic.com → API keys
ANTHROPIC_API_KEY=
# Optional model id; empty = claude-sonnet-5-5
ANTHROPIC_MODEL=
# Higgsfield (Seedance) → Video tab: short videos and the talking avatar. PAID per second of finished video; the monthly cap is
# the owner's field in Maestro → spend (empty = no cap). Keys: cloud.higgsfield.ai → API keys (a key and its secret).
HIGGSFIELD_API_KEY=
HIGGSFIELD_API_SECRET=
# Optional model path; empty = bytedance/seedance/v1/lite
HIGGSFIELD_SEEDANCE_MODEL=

# Approved execution (decisions board → توصيات القواعد). SEPARATE from the read keys above: a key made only for this, on the one ad account.
# Meta: system user with ads_management on that account only. Snapchat: OAuth app on that account. Steps: docs/media-buyer/execution.md
# Leave empty to keep real execution off (the trial without execution still needs them to read the live value).
META_WRITE_TOKEN=
META_WRITE_AD_ACCOUNT_ID=
SNAP_WRITE_CLIENT_ID=
SNAP_WRITE_CLIENT_SECRET=
SNAP_WRITE_REFRESH_TOKEN=
SNAP_WRITE_AD_ACCOUNT_ID=

# Data-age watchdog (src/lib/watchdog.ts, hourly Cron trigger): alerts when site/dash.json is older than 3 hours. Both channels are
# optional and either one is enough; with neither, the problem only shows on the health page and in the Worker log.
# Any endpoint that takes a JSON POST (Slack/Discord incoming webhook, ntfy topic URL)
ALERT_WEBHOOK_URL=
# Email through Resend (resend.com → API Keys). From must be on a domain verified in Resend; To can hold several, comma-separated
RESEND_API_KEY=
ALERT_EMAIL_FROM=
ALERT_EMAIL_TO=

# Scheduled jobs (src/lib/cron.ts, src/lib/watchdog.ts): the two Cron triggers start the hourly data refresh, the weekly backup and the monthly
# restore test by dispatching GitHub Actions workflows. Without this token NONE of them starts (the Worker only logs "GH_DISPATCH_TOKEN missing").
# A fine-grained personal access token: github.com/settings/personal-access-tokens → Repository access: only leen-saz/well-ads →
# Repository permissions: Actions = Read and write. Set an expiry date and renew it before then.
GH_DISPATCH_TOKEN=
