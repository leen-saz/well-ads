# Secrets of the Cloudflare Worker (the site). Copy to worker.env OUTSIDE the repo, fill, then:
#   npx wrangler secret bulk worker.env --name well-ads
# and delete the file. Lines left empty are skipped by you: remove them before running.

# Supabase (Leen Well account → Well project → Project Settings → API / API Keys)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# A new random value: run `openssl rand -base64 48` and paste the output
SESSION_SECRET=

# "Connect" button (authentication). Only for platforms you want the button on; each from the platform's developer page
META_APP_ID=
META_APP_SECRET=
SNAP_CLIENT_ID=
SNAP_CLIENT_SECRET=
GOOGLE_ADS_CLIENT_ID=
GOOGLE_ADS_CLIENT_SECRET=
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=
PINTEREST_APP_ID=
PINTEREST_APP_SECRET=
REDDIT_CLIENT_ID=
REDDIT_CLIENT_SECRET=
MSADS_CLIENT_ID=
MSADS_CLIENT_SECRET=
AMAZON_ADS_CLIENT_ID=
AMAZON_ADS_CLIENT_SECRET=
YANDEX_CLIENT_ID=
YANDEX_CLIENT_SECRET=
X_ADS_CONSUMER_KEY=
X_ADS_CONSUMER_SECRET=
