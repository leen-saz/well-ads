{
  "name": "well-ads",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "astro dev",
    "build": "astro build",
    "preview": "wrangler dev",
    "typecheck": "astro check && tsc --noEmit",
    "lint": "eslint .",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.integration.config.ts --passWithNoTests",
    "test:parity": "playwright test",
    "test:smoke": "playwright test --config playwright.smoke.config.ts",
    "test:parity:update": "UPDATE_GOLDEN=1 playwright test --workers=1"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.2.0",
    "@astrojs/cloudflare": "^14.4.3",
    "@astrojs/react": "^7.1.2",
    "@tanstack/react-table": "^8.21.3",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "astro": "^7.4.4",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "hono": "^4.13.14",
    "lucide-react": "^1.66.0",
    "radix-ui": "^1.8.1",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "recharts": "^3.10.1",
    "tailwind-merge": "^3.7.0"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.12",
    "@tailwindcss/vite": "^4.3.3",
    "eslint": "^10.14.0",
    "eslint-plugin-astro": "^3.2.1",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "typescript-eslint": "^8.72.1",
    "vitest": "^5.0.5",
    "wrangler": "^4.156.0",
    "@playwright/test": "^1.56.1"
  },
  "overrides": {
    "minimatch": "^11.0.5"
  }
}
