{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "well-ads",
  "main": "./src/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // OWNER_EMAIL is NOT in this public file: it is a Worker secret per environment (docs/secrets/worker.env.example).
  // Local dev uses a placeholder below; deploy.yml refuses to deploy an environment that lacks the secret.
  // Top level = local dev only. Each env has its own bindings; nothing is inherited.
  "env": {
    "staging": {
      "name": "well-ads-staging",
      "workers_dev": true,
      "vars": { "APP_ENV": "staging" },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "well-ads-files-staging" }],
      "ai": { "binding": "AI" },
      "workflows": [{ "name": "journey-run-staging", "binding": "JOURNEY", "class_name": "JourneyRun" }]
    },
    "production": {
      "name": "well-ads",
      "workers_dev": false,
      "vars": { "APP_ENV": "production" },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "well-ads-files" }],
      "ai": { "binding": "AI" },
      "workflows": [{ "name": "journey-run", "binding": "JOURNEY", "class_name": "JourneyRun" }],
      // Workers Free allows 5 cron triggers per account, so only TWO here (src/app.ts, hourlyTasks in src/lib/cron.ts):
      // every 5 minutes the due social posts; minute 7 hourly: the data refresh and the watchdog, plus the weekly backup (Sunday 02 UTC) and the monthly restore test (the 1st, 03 UTC)
      "triggers": { "crons": ["7 * * * *", "*/5 * * * *"] }
    }
  },
  "vars": { "APP_ENV": "local", "OWNER_EMAIL": "owner@example.test" },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "well-ads-files-local" }],
  "ai": { "binding": "AI" },
  "workflows": [{ "name": "journey-run-local", "binding": "JOURNEY", "class_name": "JourneyRun" }]
}
