{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "well-ads",
  "main": "./src/app.ts",
  "compatibility_date": "2026-10-01",
  "compatibility_flags": ["nodejs_compat"],
  "observability": { "enabled": true },
  // OWNER_EMAIL is config, not a credential, so it lives here instead of in secrets.
  // Top level = local dev only. Each env has its own bindings; nothing is inherited.
  "env": {
    "staging": {
      "name": "well-ads-staging",
      "workers_dev": true,
      "vars": { "APP_ENV": "staging", "OWNER_EMAIL": "leen.sulaiman@wellunion.co" },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "well-ads-files-staging" }]
    },
    "production": {
      "name": "well-ads",
      "workers_dev": false,
      "vars": { "APP_ENV": "production", "OWNER_EMAIL": "leen.sulaiman@wellunion.co" },
      "r2_buckets": [{ "binding": "FILES", "bucket_name": "well-ads-files" }],
      // Hourly data refresh (src/lib/cron.ts): GitHub's own schedule never fired for this repo
      "triggers": { "crons": ["7 * * * *"] }
    }
  },
  "vars": { "APP_ENV": "local", "OWNER_EMAIL": "leen.sulaiman@wellunion.co" },
  "r2_buckets": [{ "binding": "FILES", "bucket_name": "well-ads-files-local" }]
}
