# Copy to .env on the server:  cp .env.example .env && chmod 600 .env
# Then fill every value yourself. NEVER commit .env (it is git-ignored) and never paste it in chat or tickets.
# Generate each secret on the server with:  openssl rand -hex 32     (hex only: safe inside the database URL)

# ---- Your domain (no https://, no slash) and a real email for Let's Encrypt notices
POSTIZ_DOMAIN=social.example.com
ACME_EMAIL=you@example.com

# ---- Secrets of the stack (all required; any long random hex)
JWT_SECRET=CHANGE_ME_openssl_rand_hex_32
POSTIZ_DB_PASSWORD=CHANGE_ME_openssl_rand_hex_24
TEMPORAL_DB_PASSWORD=CHANGE_ME_openssl_rand_hex_24

# ---- Sign-up. false ONLY until the first user (you) is created, then set true and run:
#      docker compose up -d     (recreates the Postiz container with the new value)
DISABLE_REGISTRATION=false

# ---- Storage: media stays on the server's volume "postiz-uploads" (backed up nightly).
#      These three are already set in docker-compose.yaml; listed here only so nobody wonders.
#      STORAGE_PROVIDER=local   UPLOAD_DIRECTORY=/uploads   NEXT_PUBLIC_UPLOAD_DIRECTORY=/uploads

# ---- Platform developer apps. Names are exactly the ones in Postiz's docs
#      (docs.postiz.com/self-host/providers/*). Leave a pair empty if you do not use that platform.
#      After editing:  docker compose up -d   (not "restart": it does not re-read .env)

# TikTok  (redirect URI: https://<POSTIZ_DOMAIN>/integrations/social/tiktok)
TIKTOK_CLIENT_ID=
TIKTOK_CLIENT_SECRET=

# X / Twitter  (callback: https://<POSTIZ_DOMAIN>/integrations/social/x)
X_API_KEY=
X_API_SECRET=

# LinkedIn profile + LinkedIn Page share ONE app and ONE pair
#   (redirect URIs: https://<POSTIZ_DOMAIN>/integrations/social/linkedin
#                   https://<POSTIZ_DOMAIN>/integrations/social/linkedin-page)
LINKEDIN_CLIENT_ID=
LINKEDIN_CLIENT_SECRET=

# Facebook / Instagram are NOT published through Postiz in Well Ads (our Worker does it natively through the
# Meta connection), so these stay empty. Do not fill them in unless we change that decision.
# FACEBOOK_APP_ID=
# FACEBOOK_APP_SECRET=

# ---- Optional
# Postiz limit on create-post calls per hour (instance-wide). Default here 30, Postiz default 90.
# API_LIMIT=30

# ---- Used only by backup/backup.sh (it reads this same file)
# Public key of the backup encryption (age). Create the pair on YOUR computer, put only the PUBLIC key here.
BACKUP_AGE_RECIPIENT=
# rclone remote that receives the encrypted copy, e.g. r2:well-postiz-backups  (leave empty = no off-site copy; the script then fails loudly)
BACKUP_RCLONE_REMOTE=
# Optional: a healthchecks.io-style URL that the script pings after a good run (you get an email if it stops pinging)
BACKUP_PING_URL=
